data-kid=\"1-8-2-2-4-3\">\n                        <span data-kid=\"1-8-2-2-4-3-1\">\n                            Chat, bet, and enjoy the show with live dealers.\n                        </span>\n                        <span class=\"font-semibold uppercase tracking-[0.16em] text-[#667184]\" data-kid=\"1-8-2-2-4-3-2\">\n                            Let the hand begin\n                        </span>\n                    </div>\n                </article>\n            </div>\n        </div>\n    </section>\n    <section aria-labelledby=\"cta-title\" class=\"relative mx-auto max-w-6xl scroll-mt-8 px-6 pb-28 lg:px-8\" data-kid=\"1-9\" id=\"final-cta\">\n        <div class=\"relative overflow-hidden rounded-[1.75rem] border border-[#ffd700]/20 bg-[linear-gradient(120deg,#1a1406,#17130b_46%,#111923)] px-7 py-10 shadow-[0_30px_100px_rgba(0,0,0,0.34),0_0_70px_rgba(212,175,55,0.1)] sm:px-12 sm:py-14\" data-kid=\"1-9-1\">\n            <div aria-hidden=\"true\" class=\"absolute -right-24 -top-24 size-72 rounded-full bg-[#ffd700]/10 blur-3xl\" data-kid=\"1-9-1-1\">\n            </div>\n            <div class=\"relative z-10 max-w-2xl\" data-kid=\"1-9-1-2\">\n                <p class=\"mb-3 text-[10px] font-semibold uppercase tracking-[0.25em] text-[#ffd700]\" data-kid=\"1-9-1-2-1\">\n                    Your seat is waiting\n                </p>\n                <h2 class=\"text-4xl font-semibold tracking-[-0.055em] text-white sm:text-5xl\" data-kid=\"1-9-1-2-2\" id=\"cta-title\">\n                    Ready to take a seat?\n                </h2>\n                <p class=\"mt-5 max-w-xl text-base leading-7 text-[#b8c0ce]\" data-kid=\"1-9-1-2-3\">\n                    Join the waitlist for updates and early access when tables open up.\n                </p>\n                <div class=\"mt-8 flex flex-col gap-3 sm:flex-row\" data-kid=\"1-9-1-2-4\">\n                    <button class=\"rounded-xl bg-[#ffd700] px-5 py-3.5 text-sm font-bold text-[#0b0f14] shadow-[0_0_28px_rgba(255,215,0,0.18)] hover:bg-[#f2c14e] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white focus-visible:ring-offset-2 focus-visible:ring-offset-[#1a1406]\" data-kid=\"1-9-1-2-4-1\" type=\"button\">\n                        Join the waitlist\n                    </button>\n                    <a class=\"inline-flex items-center justify-center rounded-xl border border-white/15 px-5 py-3.5 text-sm font-semibold text-white hover:border-[#ffd700]/60 hover:text-[#ffd700] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#ffd700]\" data-kid=\"1-9-1-2-4-2\" href=\"#top\">\n                        Back to the top\n                        <span aria-hidden=\"true\" class=\"ml-2\" data-kid=\"1-9-1-2-4-2-1\">\n                            ↑\n                        </span>\n                    </a>\n                </div>\n            </div>\n            <div aria-label=\"Dealer chip destination\" class=\"absolute bottom-10 right-10 hidden size-24 place-items-center rounded-full border border-dashed border-[#ffd700]/35 bg-[#0b0f14]/30 sm:grid\" data-kid=\"1-9-1-3\" data-name=\"cta chip slot destination\" id=\"cta-chip-slot\">\n                <span class=\"grid size-16 place-items-center rounded-full border-[5px] border-[#1d2430] bg-[#d4af37] text-[9px] font-bold tracking-[0.12em] text-[#0b0f14] shadow-[0_0_28px_rgba(255,215,0,0.2)]\" data-dynamic=\"true\" data-kid=\"1-9-1-3-1\" data-name=\"pulsing dealer chip in footer\" data-reason=\"scale and shadow animated by loop on scroll trigger\">\n                    DEAL\n                </span>\n            </div>\n        </div>\n        <footer class=\"flex flex-col gap-3 px-1 pt-7 text-[10px] font-semibold uppercase tracking-[0.2em] text-[#667184] sm:flex-row sm:items-center sm:justify-between\" data-kid=\"1-9-2\">\n            <span data-kid=\"1-9-2-1\">\n                HuffleShuffle · Live-dealer online poker\n            </span>\n            <span data-kid=\"1-9-2-2\">\n                Real deck. Real dealer. Your next hand.\n            </span>\n        </footer>\n    </section>\n</main>\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/gsap.min.js\">\n</script>\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/ScrollTrigger.min.js\">\n</script>\n<script>\n    gsap.registerPlugin(ScrollTrigger);\n</script>\n<script>\n    (() => {\n    const page = document.querySelector('.huffle-page');\n    if (!page) return;\n\n    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;\n    const stepLinks = Array.from(page.querySelectorAll('[data-step-link]'));\n    const storyFrames = Array.from(page.querySelectorAll('[data-story-step]'));\n\n    const setActiveStep = (step) => {\n      stepLinks.forEach((link) => {\n        const active = Number(link.dataset.stepLink) === step;\n        link.setAttribute('aria-current', active ? 'step' : 'false');\n        link.querySelector('.step-title').style.color = active ? '#ffffff' : '#778295';\n        link.querySelector('.step-description').style.color = active ? '#9ba5b6' : '#667184';\n        const dot = link.querySelector('.step-dot');\n        dot.style.backgroundColor = active ? '#ffd700' : '#111923';\n        dot.style.borderColor = active ? '#ffd700' : 'rgba(255,255,255,.2)';\n        dot.style.color = active ? '#0b0f14' : '#778295';\n        dot.style.boxShadow = active ? '0 0 18px rgba(255,215,0,.35)' : 'none';\n      });\n    };\n\n    const observer = new IntersectionObserver((entries) => {\n      entries.forEach((entry) => {\n        if (entry.isIntersecting) setActiveStep(Number(entry.target.dataset.storyStep));\n      });\n    }, { threshold: 0.5, rootMargin: '-12% 0px -35% 0px' });\n    storyFrames.forEach((frame) => observer.observe(frame));\n\n    if (reduceMotion) {\n      page.querySelector('#story-wallet').textContent = 'dealer-ready account';\n      page.querySelector('#buyin-amount').textContent = '100';\n      page.querySelector('#buyin-fill').style.width = '100%';\n      page.querySelectorAll('[data-count-target]').forEach((count) => { count.textContent = count.dataset.countTarget; });\n      page.querySelectorAll('.buy-chip').forEach((chip) => { chip.style.opacity = '1'; chip.style.transform = 'none'; });\n      return;\n    }\n\n    const intro = gsap.timeline({ defaults: { ease: 'power3.out' } });\n    intro.fromTo('.hero-kicker', { autoAlpha: 0, y: 14 }, { autoAlpha: 1, y: 0, duration: .5 })\n      .fromTo('.hero-title', { autoAlpha: 0, y: 24 }, { autoAlpha: 1, y: 0, duration: .72 }, '-=.28')\n      .fromTo('.hero-copy', { autoAlpha: 0, y: 18 }, { autoAlpha: 1, y: 0, duration: .55 }, '-=.36')\n      .fromTo('.hero-actions', { autoAlpha: 0, y: 16 }, { autoAlpha: 1, y: 0, duration: .5 }, '-=.28')\n      .fromTo('.hero-note', { autoAlpha: 0 }, { autoAlpha: 1, duration: .4 }, '-=.2')\n      .fromTo('.hero-card', { autoAlpha: 0, y: 26, rotation: (index) => index === 0 ? -25 : 20 }, { autoAlpha: 1, y: 0, rotation: (index) => index === 0 ? -14 : 11, duration: .85, stagger: .12 }, '-=.65');\n\n    gsap.to('.hero-visual', { y: -18, ease: 'none', scrollTrigger: { trigger: '.hero-visual', start: 'top bottom', end: 'bottom top', scrub: .8 } });\n    gsap.fromTo('.value-card', { autoAlpha: 0, y: 28 }, { autoAlpha: 1, y: 0, duration: .55, stagger: .12, ease: 'power3.out', scrollTrigger: { trigger: '#experience', start: 'top 72%', once: true } });\n\n    storyFrames.forEach((frame) => {\n      gsap.fromTo(frame, { autoAlpha: .55, scale: .965 }, { autoAlpha: 1, scale: 1, ease: 'none', scrollTrigger: { trigger: frame, start: 'top 82%', end: 'top 36%', scrub: .65 } });\n    });\n\n    const typeTarget = page.querySelector('#story-wallet');\n    const typeText = 'dealer-ready account';\n    typeTarget.textContent = '';\n    ScrollTrigger.create({ trigger: '#story-signin', start: 'top 62%', once: true, onEnter: () => {\n      const typing = { index: 0 };\n      gsap.to(typing, { index: typeText.length, duration: 1.25, ease: 'none', snap: { index: 1 }, onUpdate: () => { typeTarget.textContent = typeText.slice(0, typing.index); } });\n    } });\n\n    page.querySelectorAll('[data-count-target]').forEach((count) => {\n      const target = Number(count.dataset.countTarget);\n      count.textContent = '0';\n      ScrollTrigger.create({ trigger: '#story-lobby', start: 'top 62%', once: true, onEnter: () => {\n        const value = { count: 0 };\n        gsap.to(value, { count: target, duration: 1.15, delay: Math.random() * .18, snap: { count: 1 }, ease: 'power2.out', onUpdate: () => { count.textContent = value.count; } });\n      } });\n    });\n\n    gsap.set('.buy-chip', { autoAlpha: 0, y: 18, scale: .8 });\n    ScrollTrigger.create({ trigger: '#story-buyin', start: 'top 62%', once: true, onEnter: () => {\n      gsap.to('.buy-chip', { autoAlpha: 1, y: 0, scale: 1, duration: .34, stagger: .1, ease: 'back.out(1.5)' });\n      const amount = { value: 0 };\n      gsap.to(amount, { value: 100, duration: 1.2, delay: .18, snap: { value: 1 }, ease: 'power2.out', onUpdate: () => { page.querySelector('#buyin-amount').textContent = amount.value; } });\n      gsap.to('#buyin-fill', { width: '100%', duration: 1.25, delay: .18, ease: 'power2.out' });\n    } });\n\n    gsap.set('.community-card, .chat-toast', { autoAlpha: 0, y: 10 });\n    ScrollTrigger.create({ trigger: '#story-live', start: 'top 62%', once: true, onEnter: () => {\n      gsap.timeline({ defaults: { ease: 'power3.out' } }).to('.community-card', { autoAlpha: 1, y: 0, duration: .35, stagger: .12 }).to('.chat-toast', { autoAlpha: 1, y: 0, duration: .35, stagger: .18 }, '-=.1');\n    } });\n\n    gsap.to('#travelling-chip', { x: '42vw', y: '158vh', rotation: 540, scale: .72, ease: 'none', scrollTrigger: { trigger: '#how-it-works', start: 'top bottom', endTrigger: '#final-cta', end: 'top center', scrub: 1 } });\n    gsap.to('#cta-chip-slot span', { scale: 1.08, boxShadow: '0 0 40px rgba(255,215,0,.35)', repeat: -1, yoyo: true, duration: 1.2, ease: 'sine.inOut', scrollTrigger: { trigger: '#final-cta', start: 'top 70%', toggleActions: 'play pause resume pause' } });\n\n    window.addEventListener('load', () => ScrollTrigger.refresh(), { once: true });\n  })();\n</script>\n",
      "comments": [],
      "created": "2026-08-11T14:42:51.085494+00:00",
      "modified": "2026-08-11T14:43:58.049728+00:00",
      "id": "var_c43458779cda",
      "viewportScrollY": 1461
    },
    "var_8b49ab156ba3": {
      "type": "variant",
      "label": "Pinned Table Story",
      "parentId": null,
      "themeId": null,
      "rect": {
        "x": 1380,
        "y": 0,
        "w": 1280,
        "h": 800
      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=Manrope:wght@400;500;600;700;800&display=swap');\n  :root {\n    --midnight: #0b0f14;\n    --midnight-soft: #101821;\n    --gold: #ffd700;\n    --gold-soft: #f2c14e;\n    --gold-deep: #d4af37;\n    --ink-muted: #9aa5b5;\n    --line: rgba(255,255,255,.11);\n  }\n  @keyframes ambient-drift {\n    0%, 100% { transform: translate3d(0, 0, 0) rotate(0deg); opacity: .34; }\n    50% { transform: translate3d(18px, -12px, 0) rotate(2deg); opacity: .52; }\n  }\n  @keyframes lobby-ticker {\n    from { transform: translateY(0); }\n    to { transform: translateY(-50%); }\n  }\n  @keyframes stack-rise {\n    0%, 100% { transform: translateY(0) rotate(var(--chip-rotation)); }\n    50% { transform: translateY(-5px) rotate(var(--chip-rotation)); }\n  }\n  @keyframes chat-pop {\n    0%, 62%, 100% { opacity: .38; transform: translate3d(0, 7px, 0) scale(.98); }\n    14%, 48% { opacity: 1; transform: translate3d(0, 0, 0) scale(1); }\n  }\n  @keyframes pulse-ring {\n    0%, 100% { opacity: .28; transform: scale(.94); }\n    50% { opacity: .7; transform: scale(1.06); }\n  }\n  .display-font { font-family: 'Manrope', sans-serif; letter-spacing: -.045em; }\n  .mono-font { font-family: 'DM Mono', monospace; }\n  .ambient-art { animation: ambient-drift 11s ease-in-out infinite; }\n  .story-panel { scroll-margin-top: 92px; }\n  .story-panel::before {\n    content: '';\n    position: absolute;\n    inset: 0;\n    pointer-events: none;\n    opacity: .34;\n    background-image: linear-gradient(rgba(255,255,255,.035) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,.035) 1px, transparent 1px);\n    background-size: 32px 32px;\n    mask-image: linear-gradient(to bottom, black, transparent 84%);\n  }\n  .ticker-mask { mask-image: linear-gradient(to bottom, transparent, black 14%, black 86%, transparent); }\n  .stack-chip { animation: stack-rise 3.2s ease-in-out infinite; }\n  .chat-bubble { animation: chat-pop 4.6s ease-in-out infinite; }\n  .chip-ring { animation: pulse-ring 2.4s ease-in-out infinite; }\n  .story-nav-item:focus-visible, .story-panel button:focus-visible, a:focus-visible, button:focus-visible, input:focus-visible {\n    outline: 2px solid var(--gold);\n    outline-offset: 4px;\n  }\n  @media (prefers-reduced-motion: reduce) {\n    .ambient-art, .stack-chip, .chat-bubble, .chip-ring { animation: none; }\n  }\n</style>\n<div class=\"relative min-h-screen overflow-x-clip bg-[#0b0f14] text-white\" data-kid=\"1\" data-name=\"page layout container\" id=\"motion-canvas\" style=\"font-family:'Manrope',sans-serif;\">\n    <header class=\"relative z-40 mx-auto flex max-w-6xl items-center justify-between px-6 py-7\" data-kid=\"1-1\" data-name=\"main navigation bar\">\n        <a aria-label=\"HuffleShuffle home\" class=\"display-font text-sm font-extrabold tracking-[.18em] text-white\" data-kid=\"1-1-1\" data-name=\"home link\" href=\"#hero\">\n            HUFFLE\n            <span class=\"text-[#FFD700]\" data-kid=\"1-1-1-1\" data-name=\"brand name suffix\">\n                SHUFFLE\n            </span>\n        </a>\n        <nav aria-label=\"Primary navigation\" class=\"hidden items-center gap-7 text-xs text-zinc-400 md:flex\" data-kid=\"1-1-2\" data-name=\"primary navigation links\">\n            <a class=\"hover:text-white\" data-kid=\"1-1-2-1\" data-name=\"why huffleshuffle navigation link\" href=\"#benefits\">\n                Why HuffleShuffle\n            </a>\n            <a class=\"hover:text-white\" data-kid=\"1-1-2-2\" data-name=\"how it works navigation link\" href=\"#how-it-works\">\n                How it works\n            </a>\n            <a class=\"hover:text-white\" data-kid=\"1-1-2-3\" data-name=\"early access navigation link\" href=\"#final-cta\">\n                Early access\n            </a>\n        </nav>\n        <a aria-label=\"Enter the HuffleShuffle lobby\" class=\"group inline-flex items-center gap-2 rounded-full border border-white/15 px-4 py-2 text-xs font-semibold text-white hover:border-[#FFD700]/60 hover:text-[#FFD700]\" data-kid=\"1-1-3\" data-name=\"enter lobby call-to-action button\" href=\"#final-cta\">\n            Enter Lobby\n            <span aria-hidden=\"true\" class=\"text-[#FFD700]\" data-kid=\"1-1-3-1\" data-name=\"arrow icon\">\n                ↗\n            </span>\n        </a>\n    </header>\n    <div class=\"pointer-events-none absolute inset-0 -z-0 bg-[radial-gradient(ellipse_at_top_right,rgba(255,215,0,0.13),transparent_46%),radial-gradient(ellipse_at_bottom_left,rgba(255,215,0,0.09),transparent_48%)]\" data-kid=\"1-2\" data-name=\"hero section radial background\">\n    </div>\n    <div class=\"pointer-events-none absolute inset-0 -z-0 bg-[linear-gradient(180deg,rgba(212,175,55,0.045)_0%,transparent_28%,rgba(212,175,55,0.025)_72%,transparent_100%)]\" data-kid=\"1-3\" data-name=\"hero section linear background\">\n    </div>\n    <img alt=\"Decorative gold club and chip arc\" class=\"ambient-art pointer-events-none absolute right-[-260px] top-[70px] z-0 h-[720px] w-auto opacity-35 mix-blend-screen\" data-kid=\"1-4\" data-name=\"decorative gold club and chip arc\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/public/shuffle1.png\"/>\n    <img alt=\"Decorative gold chip arc\" class=\"ambient-art pointer-events-none absolute bottom-[560px] left-[-300px] z-0 h-[760px] w-auto opacity-25 mix-blend-screen\" data-kid=\"1-5\" data-name=\"decorative gold chip arc\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/public/shuffle2.png\" style=\"animation-delay:-5s\"/>\n    <div aria-label=\"Traveling gold dealer button\" class=\"pointer-events-none absolute left-[calc(50%+292px)] top-[516px] z-10 flex size-[68px] -translate-x-1/2 items-center justify-center rounded-full border-[3px] border-[#ffd700] bg-[radial-gradient(circle_at_35%_28%,#fff2a7,#e8ac1b_45%,#8d5b07_100%)] shadow-[0_0_0_8px_rgba(255,215,0,.08),0_14px_36px_rgba(255,215,0,.28)]\" data-dynamic=\"true\" data-kid=\"1-6\" data-name=\"traveling gold dealer button\" data-reason=\"element moved and rotated along path by scroll-triggered script\" id=\"dealer-chip\">\n        <span class=\"chip-ring absolute inset-[-10px] rounded-full border border-[#FFD700]/60\" data-kid=\"1-6-1\" data-name=\"dealer button pulsing ring\">\n        </span>\n        <span class=\"relative flex size-11 items-center justify-center rounded-full border border-[#5a3904]/70 text-[11px] font-extrabold tracking-[.12em] text-[#392302]\" data-kid=\"1-6-2\" data-name=\"dealer button label\">\n            D\n        </span>\n    </div>\n    <section class=\"relative z-20 mx-auto grid min-h-[820px] max-w-6xl items-center gap-10 px-6 pb-24 pt-16 lg:grid-cols-[1.03fr_.97fr] lg:pt-10\" data-kid=\"1-7\" data-name=\"hero section\" id=\"hero\">\n        <div class=\"hero-copy max-w-[650px]\" data-kid=\"1-7-1\" data-name=\"hero content column\">\n            <div class=\"hero-eyebrow mono-font mb-7 inline-flex items-center gap-3 text-[11px] font-medium uppercase tracking-[.25em] text-[#f2c14e]\" data-kid=\"1-7-1-1\" data-name=\"hero eyebrow label\">\n                <span class=\"size-2 rounded-full bg-[#FFD700] shadow-[0_0_18px_rgba(255,215,0,.7)]\" data-kid=\"1-7-1-1-1\" data-name=\"live status indicator dot\">\n                </span>\n                Live-dealer experience · early access\n            </div>\n            <h1 class=\"display-font max-w-[700px] text-[clamp(3.3rem,7vw,6.9rem)] font-medium leading-[.94] text-white\" data-kid=\"1-7-1-2\" data-name=\"hero headline\">\n                Live-Dealer\n                <br data-kid=\"1-7-1-2-1\" data-name=\"headline line break\"/>\n                <span class=\"text-[#FFD700]\" data-kid=\"1-7-1-2-2\" data-name=\"headline highlight text\">\n                    Online Poker\n                </span>\n            </h1>\n            <p class=\"hero-subhead mt-8 max-w-[570px] text-lg leading-8 text-zinc-300 md:text-xl\" data-kid=\"1-7-1-3\" data-name=\"hero subhead text\">\n                Join a table and play Texas Hold’em streamed live with a live dealer. Simple, fast, and social.\n            </p>\n            <div class=\"hero-actions mt-10 flex flex-col gap-4 sm:flex-row sm:items-stretch\" data-kid=\"1-7-1-4\" data-name=\"hero call-to-action container\">\n                <a class=\"magnetic-button inline-flex min-h-14 items-center justify-center gap-3 rounded-full bg-[#FFD700] px-7 text-sm font-extrabold text-[#11130f] shadow-[0_0_34px_rgba(255,215,0,.18)] hover:bg-[#f2c14e]\" data-kid=\"1-7-1-4-1\" data-name=\"enter lobby button\" href=\"#how-it-works\" id=\"hero-lobby\">\n                    Enter Lobby\n                    <span aria-hidden=\"true\" class=\"text-base\" data-kid=\"1-7-1-4-1-1\" data-name=\"arrow icon\">\n                        ↗\n                    </span>\n                </a>\n                <form aria-label=\"Join the HuffleShuffle waitlist\" class=\"waitlist-form min-w-0 rounded-2xl border border-white/12 bg-white/[.045] p-2 backdrop-blur-sm\" data-kid=\"1-7-1-4-2\" data-name=\"hero waitlist form\">\n                    <div class=\"flex items-center gap-2\" data-kid=\"1-7-1-4-2-1\" data-name=\"form group\">\n                        <label class=\"sr-only\" data-kid=\"1-7-1-4-2-1-1\" data-name=\"email label\" for=\"hero-email\">\n                            Email address\n                        </label>\n                        <input class=\"min-w-0 flex-1 bg-transparent px-3 py-3 text-sm text-white placeholder:text-zinc-500 focus:outline-hidden\" data-kid=\"1-7-1-4-2-1-2\" data-name=\"email input field\" id=\"hero-email\" placeholder=\"you@email.com\" required=\"\" type=\"email\"/>\n                        <button class=\"waitlist-submit shrink-0 rounded-xl border border-[#FFD700]/55 px-4 py-3 text-xs font-bold text-[#FFD700] hover:bg-[#FFD700] hover:text-[#11130f]\" data-dynamic=\"true\" data-kid=\"1-7-1-4-2-1-3\" data-name=\"waitlist submit button\" data-reason=\"text and visual state updated on form submission\" type=\"submit\">\n                            Join waitlist\n                        </button>\n                    </div>\n                    <p aria-live=\"polite\" class=\"form-status px-3 pb-1 pt-2 text-[10px] text-zinc-500\" data-dynamic=\"true\" data-kid=\"1-7-1-4-2-2\" data-name=\"form status message\" data-reason=\"text content updated on form submission\">\n                        No spam. Just your seat when tables open.\n                    </p>\n                </form>\n            </div>\n            <div class=\"hero-stats mt-12 flex flex-wrap gap-x-9 gap-y-4 border-t border-white/10 pt-6\" data-kid=\"1-7-1-5\" data-name=\"hero stats container\">\n                <div data-kid=\"1-7-1-5-1\" data-name=\"stat item 1\">\n                    <div class=\"display-font text-2xl font-semibold text-white\" data-kid=\"1-7-1-5-1-1\" data-name=\"stat value\">\n                        24/7\n                    </div>\n                    <div class=\"mono-font mt-1 text-[10px] uppercase tracking-[.16em] text-zinc-500\" data-kid=\"1-7-1-5-1-2\" data-name=\"stat label\">\n                        Live tables\n                    </div>\n                </div>\n                <div data-kid=\"1-7-1-5-2\" data-name=\"stat item 2\">\n                    <div class=\"display-font text-2xl font-semibold text-white\" data-kid=\"1-7-1-5-2-1\" data-name=\"stat value\">\n                        100%\n                    </div>\n                    <div class=\"mono-font mt-1 text-[10px] uppercase tracking-[.16em] text-zinc-500\" data-kid=\"1-7-1-5-2-2\" data-name=\"stat label\">\n                        Real decks\n                    </div>\n                </div>\n                <div data-kid=\"1-7-1-5-3\" data-name=\"stat item 3\">\n                    <div class=\"display-font text-2xl font-semibold text-white\" data-kid=\"1-7-1-5-3-1\" data-name=\"stat value\">\n                        0\n                    </div>\n                    <div class=\"mono-font mt-1 text-[10px] uppercase tracking-[.16em] text-zinc-500\" data-kid=\"1-7-1-5-3-2\" data-name=\"stat label\">\n                        Downloads\n                    </div>\n                </div>\n            </div>\n        </div>\n        <div class=\"hero-visual relative mx-auto flex min-h-[560px] w-full max-w-[560px] items-center justify-center lg:justify-end\" data-kid=\"1-7-2\" data-name=\"hero visual column\">\n            <div class=\"absolute right-[5%] top-[12%] size-[360px] rounded-full border border-[#FFD700]/10 bg-[#FFD700]/[.035] blur-[1px]\" data-kid=\"1-7-2-1\" data-name=\"visual decorative circle\">\n            </div>\n            <div class=\"absolute bottom-[12%] left-[9%] rounded-full border border-white/10 bg-white/[.035] px-4 py-2 text-[10px] text-zinc-400 backdrop-blur-sm\" data-kid=\"1-7-2-2\" data-name=\"status label tag\">\n                <span class=\"mr-2 inline-block size-1.5 rounded-full bg-emerald-400\" data-kid=\"1-7-2-2-1\" data-name=\"status indicator dot\">\n                </span>\n                dealer online\n            </div>\n            <div class=\"hero-card-left tilt-card absolute left-[8%] top-[9%] w-[230px] rotate-[-12deg] rounded-[26px] shadow-[0_34px_75px_rgba(0,0,0,.5)] sm:w-[260px]\" data-kid=\"1-7-2-3\" data-name=\"left tilted card\">\n                <img alt=\"Gold Ace of Hearts card\" class=\"block aspect-[2/3] w-full rounded-[26px] object-cover\" data-kid=\"1-7-2-3-1\" data-name=\"ace of hearts card image\" decoding=\"async\" loading=\"eager\" src=\"/api/local/images/public/AceHeart.png\"/>\n            </div>\n            <div class=\"hero-card-right tilt-card absolute right-[3%] top-[20%] z-10 w-[248px] rotate-[9deg] rounded-[26px] shadow-[0_34px_75px_rgba(0,0,0,.56)] sm:w-[282px]\" data-kid=\"1-7-2-4\" data-name=\"right tilted card\">\n                <img alt=\"Gold Ace of Spades card\" class=\"block aspect-[2/3] w-full rounded-[26px] object-