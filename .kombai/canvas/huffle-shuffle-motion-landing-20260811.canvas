3-2-2-4-2-2-2-2-1-1\" data-name=\"step 4 hole card suit\">\n                                                ♥\n                                            </span>\n                                        </span>\n                                        <span class=\"hand-card grid h-16 w-12 place-items-center rounded-lg border border-white/20 bg-[#f3eee1] text-center text-slate-800 shadow-[0_10px_25px_rgba(0,0,0,0.28)]\" data-dynamic=\"true\" data-kid=\"1-8-3-2-2-4-2-2-2-2-2\" data-name=\"hole card king of spades\" data-reason=\"position and opacity reinitialized by scroll-triggered GSAP animation\">\n                                            K\n                                            <span class=\"text-[18px]\" data-kid=\"1-8-3-2-2-4-2-2-2-2-2-1\" data-name=\"step 4 hole card suit\">\n                                                ♠\n                                            </span>\n                                        </span>\n                                    </div>\n                                    <div class=\"mt-6 flex justify-center gap-1.5\" data-kid=\"1-8-3-2-2-4-2-2-2-3\" data-name=\"step 4 community cards\">\n                                        <span class=\"grid h-9 w-7 place-items-center rounded border border-white/20 bg-[#f3eee1] text-sm text-rose-500\" data-kid=\"1-8-3-2-2-4-2-2-2-3-1\" data-name=\"step 4 community card 1\">\n                                            7♦\n                                        </span>\n                                        <span class=\"grid h-9 w-7 place-items-center rounded border border-white/20 bg-[#f3eee1] text-sm text-slate-800\" data-kid=\"1-8-3-2-2-4-2-2-2-3-2\" data-name=\"step 4 community card 2\">\n                                            J♣\n                                        </span>\n                                        <span class=\"grid h-9 w-7 place-items-center rounded border border-white/20 bg-[#f3eee1] text-sm text-rose-500\" data-kid=\"1-8-3-2-2-4-2-2-2-3-3\" data-name=\"step 4 community card 3\">\n                                            2♥\n                                        </span>\n                                    </div>\n                                    <div class=\"mt-auto flex items-center justify-between pt-5 text-[10px] uppercase tracking-[0.16em] text-slate-500\" data-kid=\"1-8-3-2-2-4-2-2-2-4\" data-name=\"step 4 hand footer\">\n                                        <span data-kid=\"1-8-3-2-2-4-2-2-2-4-1\" data-name=\"step 4 pot value\">\n                                            Pot $420\n                                        </span>\n                                        <span class=\"text-[#ffe39a]\" data-kid=\"1-8-3-2-2-4-2-2-2-4-2\" data-name=\"step 4 action call\">\n                                            Call $2 ↗\n                                        </span>\n                                    </div>\n                                </div>\n                                <div class=\"mt-3 flex items-center gap-2 rounded-xl border border-white/10 bg-black/20 px-3 py-2 text-xs text-slate-500\" data-kid=\"1-8-3-2-2-4-2-2-3\" data-name=\"step 4 hand chat\">\n                                    <span class=\"h-2 w-2 rounded-full bg-[#f4c95d]\" data-kid=\"1-8-3-2-2-4-2-2-3-1\" data-name=\"step 4 input indicator\">\n                                    </span>\n                                    Dealer ready. Good luck.\n                                </div>\n                            </div>\n                        </div>\n                        <p class=\"mt-8 text-center text-xs uppercase tracking-[0.18em] text-slate-500\" data-kid=\"1-8-3-2-2-4-3\" data-name=\"step 4 instructional text\">\n                            Chat, bet, and enjoy the show with live dealers.\n                        </p>\n                    </article>\n                </div>\n            </div>\n        </section>\n    </main>\n</div>\n<section class=\"relative mx-auto mb-32 max-w-7xl px-8 lg:px-12\" data-kid=\"1-8-4\" data-name=\"final call to action section\" id=\"final-cta\">\n    <div class=\"relative overflow-hidden rounded-[32px] border border-[#f4c95d]/25 bg-[linear-gradient(125deg,#1c160a_0%,#111821_58%,#0c1118_100%)] px-8 py-16 shadow-[0_30px_120px_rgba(0,0,0,0.35),0_0_80px_rgba(244,201,93,0.08)] md:px-16 md:py-20\" data-kid=\"1-8-4-1\" data-name=\"final CTA card\">\n        <div class=\"pointer-events-none absolute -right-20 -top-24 h-80 w-80 rounded-full bg-[#f4c95d]/10 blur-3xl\" data-kid=\"1-8-4-1-1\" data-name=\"final CTA glow\">\n        </div>\n        <div class=\"relative z-10 grid items-center gap-12 lg:grid-cols-[1fr_250px]\" data-kid=\"1-8-4-1-2\" data-name=\"final CTA layout\">\n            <div data-kid=\"1-8-4-1-2-1\" data-name=\"final CTA copy\">\n                <p class=\"mb-4 text-xs uppercase tracking-[0.28em] text-[#f4c95d]\" data-kid=\"1-8-4-1-2-1-1\" data-name=\"final CTA eyebrow\">\n                    Your seat is waiting\n                </p>\n                <h2 class=\"font-['Space_Grotesk'] text-5xl leading-[0.98] tracking-[-0.06em] text-[#f8e6af] md:text-7xl\" data-kid=\"1-8-4-1-2-1-2\" data-name=\"final CTA heading\">\n                    Ready to take\n                    <br data-kid=\"1-8-4-1-2-1-2-1\" data-name=\"heading line break\"/>\n                    a seat?\n                </h2>\n                <p class=\"mt-6 max-w-xl text-base leading-7 text-slate-400\" data-kid=\"1-8-4-1-2-1-3\" data-name=\"final CTA description\">\n                    Pick a table and play with real people and real dealers in minutes. The next hand starts when you do.\n                </p>\n                <div class=\"mt-8 flex flex-wrap items-center gap-5\" data-kid=\"1-8-4-1-2-1-4\" data-name=\"final CTA action group\">\n                    <form aria-label=\"Join the HuffleShuffle waitlist from final call to action\" class=\"flex w-full max-w-[360px] items-center gap-2 rounded-2xl border border-white/12 bg-black/20 p-1.5 pl-4\" data-kid=\"1-8-4-1-2-1-4-1\" data-name=\"final CTA form\">\n                        <label class=\"sr-only\" data-kid=\"1-8-4-1-2-1-4-1-1\" data-name=\"final email label\" for=\"final-email\">\n                            Email address\n                        </label>\n                        <i aria-hidden=\"true\" class=\"ti ti-mail text-[17px] text-slate-500\" data-kid=\"1-8-4-1-2-1-4-1-2\" data-name=\"final email icon\">\n                        </i>\n                        <input autocomplete=\"email\" class=\"min-w-0 flex-1 bg-transparent py-2 text-sm text-white outline-none placeholder:text-slate-600\" data-kid=\"1-8-4-1-2-1-4-1-3\" data-name=\"final email input\" id=\"final-email\" placeholder=\"you@example.com\" type=\"email\"/>\n                        <button class=\"rounded-xl bg-[#f4c95d] px-4 py-2.5 text-sm font-semibold text-[#241705] hover:bg-[#ffe39a] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-3 focus-visible:outline-[#ffe39a]\" data-kid=\"1-8-4-1-2-1-4-1-4\" data-name=\"final submit button\" id=\"final-cta-button\" type=\"button\">\n                            Join waitlist\n                        </button>\n                    </form>\n                    <a class=\"text-sm font-semibold text-[#ffe39a] hover:text-white focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[#ffe39a]\" data-kid=\"1-8-4-1-2-1-4-2\" data-name=\"back to top link\" href=\"#hero\">\n                        Back to the top\n                        <i aria-hidden=\"true\" class=\"ti ti-arrow-up-right text-[15px]\" data-kid=\"1-8-4-1-2-1-4-2-1\" data-name=\"up-right arrow icon\">\n                        </i>\n                    </a>\n                </div>\n            </div>\n            <div class=\"relative mx-auto grid h-[190px] w-[190px] place-items-center rounded-[28px] border border-dashed border-[#f4c95d]/55 bg-[#f4c95d]/[0.05] shadow-[inset_0_0_45px_rgba(244,201,93,0.06)]\" data-kid=\"1-8-4-1-2-2\" data-name=\"final chip slot\" id=\"chip-slot\">\n                <div class=\"absolute -top-3 left-5 rounded-full border border-[#f4c95d]/25 bg-[#1b150a] px-3 py-1 text-[9px] uppercase tracking-[0.18em] text-[#f4c95d]\" data-kid=\"1-8-4-1-2-2-1\" data-name=\"slot land here label\">\n                    land here\n                </div>\n                <div class=\"text-center\" data-kid=\"1-8-4-1-2-2-2\" data-name=\"slot empty icon container\">\n                    <i aria-hidden=\"true\" class=\"ti ti-circle-dashed text-[34px] text-[#f4c95d]/25\" data-kid=\"1-8-4-1-2-2-2-1\" data-name=\"slot icon\">\n                    </i>\n                    <div class=\"mt-3 text-[10px] uppercase tracking-[0.18em] text-slate-600\" data-kid=\"1-8-4-1-2-2-2-2\" data-name=\"slot label\">\n                        dealer button\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>\n</section>\n<footer class=\"relative z-10 mx-auto flex max-w-7xl flex-col gap-4 border-t border-white/10 px-8 pb-10 pt-7 text-[10px] uppercase tracking-[0.2em] text-slate-600 md:flex-row md:items-center md:justify-between lg:px-12\" data-kid=\"1-9\" data-name=\"page footer\">\n    <span data-kid=\"1-9-1\" data-name=\"copyright text\">\n        © 2026 HuffleShuffle\n    </span>\n    <span data-kid=\"1-9-2\" data-name=\"slogan text\">\n        Real decks · live dealers · good times\n    </span>\n    <span data-kid=\"1-9-3\" data-name=\"footer branding\">\n        Built for the table\n    </span>\n</footer>\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/gsap.min.js\">\n</script>\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/ScrollTrigger.min.js\">\n</script>\n<script>\n    gsap.registerPlugin(ScrollTrigger);\n</script>\n<script>\n    (() => {\n    const page = document.querySelector('#page');\n    const routeSvg = document.querySelector('#route-svg');\n    const route = document.querySelector('#dealer-route');\n    const routeGlow = document.querySelector('#dealer-route-glow');\n    const chip = document.querySelector('#dealer-token');\n    const slot = document.querySelector('#chip-slot');\n    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;\n\n    if (!page || !route || !routeSvg || !chip || !slot) return;\n\n    const navItems = gsap.utils.toArray('[data-step-nav]');\n    const storyFrames = gsap.utils.toArray('[data-story-frame]');\n    const openSeats = document.querySelector('[data-count-target=\"12\"]');\n    const buyInValue = document.querySelector('[data-name=\"step 3 buy-in value\"]');\n    const stackTotal = document.querySelector('[data-stack-total]');\n    const buyInProgress = document.querySelector('[data-buy-in-progress]');\n    const setActiveStep = (step) => navItems.forEach((item) => item.classList.toggle('is-active', item.dataset.stepNav === step));\n    const animateNumber = (element, target, formatter) => {\n      if (!element || element.dataset.counted === 'true') return;\n      element.dataset.counted = 'true';\n      const state = { value: 0 };\n      gsap.to(state, { value: target, duration: 0.95, snap: { value: 1 }, ease: 'power2.out', onUpdate: () => { element.textContent = formatter(Math.round(state.value)); } });\n    };\n    const animateBuyIn = () => {\n      animateNumber(buyInValue, 100, (value) => `$${value}`);\n      animateNumber(stackTotal, 100, (value) => `$${value}.00`);\n      if (buyInProgress) gsap.to(buyInProgress, { scaleX: 1, duration: 1.05, ease: 'power2.out' });\n    };\n    const showStaticValues = () => {\n      if (openSeats) openSeats.textContent = '12';\n      if (buyInValue) buyInValue.textContent = '$100';\n      if (stackTotal) stackTotal.textContent = '$100.00';\n      if (buyInProgress) gsap.set(buyInProgress, { scaleX: 1 });\n      gsap.set('[data-stack-chip]', { y: 0, autoAlpha: 1 });\n    };\n\n    setActiveStep('1');\n\n    if (reduceMotion) {\n      page.classList.add('motion-reduced');\n      slot.appendChild(chip);\n      chip.classList.add('static-chip');\n      chip.removeAttribute('style');\n      storyFrames.forEach((frame) => frame.classList.add('is-in-view'));\n      showStaticValues();\n      return;\n    }\n\n    const intro = gsap.timeline({ defaults: { ease: 'power3.out' } });\n    intro\n      .from('.hero-stage', { autoAlpha: 0, y: 28, scale: 0.96, duration: 0.8 })\n      .from('.hero-copy .hero-entrance', { autoAlpha: 0, y: 22, stagger: 0.08, duration: 0.54 }, '-=0.5');\n\n    document.querySelectorAll('[data-tilt-card]').forEach((card) => {\n      const bounds = () => card.getBoundingClientRect();\n      card.addEventListener('pointermove', (event) => {\n        const rect = bounds();\n        const x = (event.clientX - rect.left) / rect.width - 0.5;\n        const y = (event.clientY - rect.top) / rect.height - 0.5;\n        gsap.to(card, { rotationY: x * 10, rotationX: y * -10, z: 12, duration: 0.45, ease: 'power2.out', overwrite: 'auto' });\n      });\n      card.addEventListener('pointerleave', () => gsap.to(card, { rotationY: Number(card.dataset.baseRotation || 0), rotationX: 0, z: 0, duration: 0.7, ease: 'power3.out', overwrite: 'auto' }));\n    });\n\n    const totalLength = route.getTotalLength();\n    route.style.strokeDasharray = totalLength;\n    route.style.strokeDashoffset = totalLength;\n    routeGlow.style.strokeDasharray = totalLength;\n    routeGlow.style.strokeDashoffset = totalLength;\n\n    const setChipPosition = (progress) => {\n      const svgRect = routeSvg.getBoundingClientRect();\n      const pageRect = page.getBoundingClientRect();\n      const point = route.getPointAtLength(totalLength * progress);\n      const widthScale = svgRect.width / 1280;\n      const heightScale = svgRect.height / 5000;\n      const x = svgRect.left - pageRect.left + point.x * widthScale - chip.offsetWidth / 2;\n      const y = svgRect.top - pageRect.top + point.y * heightScale - chip.offsetHeight / 2;\n      gsap.set(chip, { x, y, rotation: progress * 320 - 18 });\n    };\n\n    setChipPosition(0);\n\n    ScrollTrigger.create({\n      trigger: page,\n      start: 'top top',\n      end: 'bottom bottom',\n      scrub: 1,\n      onUpdate: (self) => {\n        const progress = self.progress;\n        const dash = totalLength * (1 - progress);\n        route.style.strokeDashoffset = dash;\n        routeGlow.style.strokeDashoffset = dash;\n        if (progress < 0.94) {\n          setChipPosition(progress);\n          chip.classList.remove('is-landed');\n        } else {\n          const slotRect = slot.getBoundingClientRect();\n          const pageRect = page.getBoundingClientRect();\n          gsap.to(chip, { x: slotRect.left - pageRect.left + slotRect.width / 2 - chip.offsetWidth / 2, y: slotRect.top - pageRect.top + slotRect.height / 2 - chip.offsetHeight / 2, rotation: 0, duration: 0.55, ease: 'back.out(1.4)', overwrite: 'auto' });\n          chip.classList.add('is-landed');\n        }\n      }\n    });\n\n    gsap.from('[data-reveal]', { autoAlpha: 0, y: 28, stagger: 0.08, duration: 0.62, ease: 'power3.out', scrollTrigger: { trigger: '#value-props', start: 'top 76%', once: true } });\n\n    storyFrames.forEach((frame) => {\n      ScrollTrigger.create({\n        trigger: frame,\n        start: 'top 62%',\n        end: 'bottom 38%',\n        onToggle: (self) => {\n          if (self.isActive) {\n            frame.classList.add('is-in-view');\n            setActiveStep(frame.dataset.storyFrame);\n            if (frame.dataset.storyFrame === '2') animateNumber(openSeats, 12, (value) => `${value}`);\n          } else {\n            frame.classList.remove('is-in-view');\n          }\n        }\n      });\n    });\n\n    gsap.fromTo('[data-stack-chip]', { y: 18, autoAlpha: 0.35 }, { y: 0, autoAlpha: 1, stagger: 0.08, duration: 0.62, ease: 'back.out(1.4)', scrollTrigger: { trigger: '#story-buy-in', start: 'top 62%', once: true, onEnter: animateBuyIn } });\n    gsap.fromTo('.dealer-cam-image', { autoAlpha: 0.35, scale: 1.08 }, { autoAlpha: 1, scale: 1.03, duration: 0.9, ease: 'power3.out', scrollTrigger: { trigger: '#story-play-live', start: 'top 62%', once: true } });\n    gsap.fromTo('.hand-card', { y: 16, rotation: (index) => index ? 6 : -6, autoAlpha: 0 }, { y: 0, rotation: (index) => index ? 3 : -3, autoAlpha: 1, stagger: 0.12, duration: 0.55, ease: 'back.out(1.4)', scrollTrigger: { trigger: '#story-play-live', start: 'top 62%', once: true } });\n\n    const magnetic = document.querySelector('#final-cta-button');\n    if (magnetic) {\n      magnetic.addEventListener('pointermove', (event) => {\n        const rect = magnetic.getBoundingClientRect();\n        gsap.to(magnetic, { x: (event.clientX - rect.left - rect.width / 2) * 0.18, y: (event.clientY - rect.top - rect.height / 2) * 0.18, duration: 0.25, ease: 'power2.out', overwrite: 'auto' });\n      });\n      magnetic.addEventListener('pointerleave', () => gsap.to(magnetic, { x: 0, y: 0, duration: 0.45, ease: 'elastic.out(1, 0.45)', overwrite: 'auto' }));\n    }\n\n    window.addEventListener('load', () => ScrollTrigger.refresh());\n  })();\n</script>\n",
      "comments": [],
      "created": "2026-08-11T14:43:16.194784+00:00",
      "modified": "2026-08-11T15:23:57.281102+00:00",
      "id": "var_65be82cfdfd5",
      "viewportScrollY": 0
    },
    "var_a5bbfb5374c0": {
      "type": "variant",
      "label": "BG Atmosphere Moodboard",
      "parentId": null,
      "themeId": null,
      "rect": {
        "x": 4140,
        "y": 0,
        "w": 1280,
        "h": 900
      },
      "html": "<style>\n  @import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Space+Grotesk:wght@500;600;700&display=swap');\n  .mood {\n    --midnight: #080b11;\n    --panel: #111821;\n    --gold: #f4c95d;\n    --gold-bright: #ffe39a;\n    --ink: #f8e6af;\n    --muted: #8993a7;\n    --line: rgba(255,227,154,0.16);\n    margin: 0;\n    min-height: 100%;\n    background: linear-gradient(180deg, #0d131d 0%, #080b11 40%, #06080c 100%);\n    color: #fff;\n    font-family: 'DM Sans', sans-serif;\n    padding: 40px 48px 64px;\n    box-sizing: border-box;\n  }\n  .mood * { box-sizing: border-box; }\n  .eyebrow {\n    color: var(--gold);\n    font-size: 11px;\n    letter-spacing: 0.28em;\n    text-transform: uppercase;\n    margin: 0 0 12px;\n  }\n  h1 {\n    font-family: 'Space Grotesk', sans-serif;\n    font-size: 44px;\n    letter-spacing: -0.05em;\n    color: var(--ink);\n    margin: 0 0 12px;\n    line-height: 1.05;\n  }\n  .lede {\n    max-width: 720px;\n    color: var(--muted);\n    font-size: 16px;\n    line-height: 1.6;\n    margin: 0 0 36px;\n  }\n  .note {\n    border: 1px solid var(--line);\n    background: rgba(244,201,93,0.06);\n    border-radius: 16px;\n    padding: 16px 18px;\n    color: #d8c89a;\n    font-size: 14px;\n    line-height: 1.5;\n    margin-bottom: 40px;\n  }\n  h2 {\n    font-family: 'Space Grotesk', sans-serif;\n    font-size: 24px;\n    color: var(--ink);\n    margin: 0 0 16px;\n    letter-spacing: -0.03em;\n  }\n  .grid {\n    display: grid;\n    grid-template-columns: 1fr 1fr;\n    gap: 16px;\n    margin-bottom: 48px;\n  }\n  .card {\n    border: 1px solid rgba(255,255,255,0.1);\n    background: rgba(17,24,33,0.88);\n    border-radius: 20px;\n    overflow: hidden;\n  }\n  .card img {\n    display: block;\n    width: 100%;\n    height: 210px;\n    object-fit: cover;\n    object-position: top;\n    background: #0a0f16;\n  }\n  .card .body { padding: 16px 18px 18px; }\n  .tag {\n    display: inline-block;\n    font-size: 10px;\n    letter-spacing: 0.18em;\n    text-transform: uppercase;\n    color: var(--gold);\n    margin-bottom: 8px;\n  }\n  .card h3 {\n    font-family: 'Space Grotesk', sans-serif;\n    font-size: 18px;\n    color: var(--ink);\n    margin: 0 0 8px;\n  }\n  .card p {\n    margin: 0;\n    color: var(--muted);\n    font-size: 13px;\n    line-height: 1.5;\n  }\n  .dirs {\n    display: grid;\n    grid-template-columns: 1fr 1fr;\n    gap: 16px;\n  }\n  .dir {\n    border: 1px solid rgba(255,255,255,0.1);\n    background: rgba(17,24,33,0.88);\n    border-radius: 20px;\n    padding: 18px;\n  }\n  .dir.pick {\n    border-color: rgba(244,201,93,0.45);\n    box-shadow: 0 0 0 1px rgba(244,201,93,0.12);\n  }\n  .dir .pill {\n    display: inline-block;\n    border: 1px solid rgba(244,201,93,0.35);\n    color: var(--gold-bright);\n    border-radius: 999px;\n    padding: 4px 10px;\n    font-size: 10px;\n    letter-spacing: 0.16em;\n    text-transform: uppercase;\n    margin-bottom: 10px;\n  }\n  .dir h3 {\n    font-family: 'Space Grotesk', sans-serif;\n    margin: 0 0 8px;\n    color: var(--ink);\n    font-size: 20px;\n  }\n  .dir p { margin: 0 0 10px; color: var(--muted); font-size: 13px; line-height: 1.5; }\n  .prompt {\n    margin: 0;\n    padding: 12px;\n    border-radius: 12px;\n    background: rgba(0,0,0,0.28);\n    border: 1px solid rgba(255,255,255,0.06);\n    color: #c9d0dc;\n    font-size: 12px;\n    line-height: 1.45;\n  }\n  .footer {\n    margin-top: 36px;\n    color: #667084;\n    font-size: 12px;\n    line-height: 1.5;\n  }\n</style>\n<div class=\"mood\">\n  <p class=\"eyebrow\">Background brainstorm</p>\n  <h1>Atmosphere refs → poker translation</h1>\n  <p class=\"lede\">Your attached inspirations favor soft ribbons, glass hue slabs, particle blooms, and node rings — not literal felt. Below: the refs, then gold/midnight directions for Higgsfield generation.</p>\n  <div class=\"note\">Keep the SaaS structure (one bold abstract graphic + empty space), but swap neon purple/blue/orange for champagne gold on midnight so it still feels like HuffleShuffle.</div>\n\n  <h2>Your inspirations</h2>\n  <div class=\"grid\">\n    <article class=\"card\">\n      <img src=\"/api/local/images/public/landing/inspo/soft-waves-glass-hues.png\" alt=\"Soft waves and glass hues inspiration\" />\n      <div class=\"body\">\n        <div class=\"tag\">Ref A</div>\n        <h3>Soft waves + glass hues</h3>\n        <p>Flowing dotted/gradient ribbons and translucent multi-hue slabs as atmosphere.</p>\n      </div>\n    </article>\n    <article class=\"card\">\n      <img src=\"/api/local/images/public/landing/inspo/particle-orbs-mesh.png\" alt=\"Particle orbs and mesh inspiration\" />\n      <div class=\"body\">\n        <div class=\"tag\">Ref B</div>\n        <h3>Particle orbs + mesh</h3>\n        <p>Dense glowing particle spheres, wireframe mesh, soft light streaks.</p>\n      </div>\n    </article>\n    <article class=\"card\">\n      <img src=\"/api/local/images/public/landing/inspo/color-ribbon-fan.png\" alt=\"Color ribbon fan inspiration\" />\n      <div class=\"body\">\n        <div class=\"tag\">Ref C</div>\n        <h3>Color ribbon fan</h3>\n        <p>One strong motion: feathered ribbons sweeping from a focal origin.</p>\n      </div>\n    </article>\n    <article class=\"card\">\n      <img src=\"/api/local/images/public/landing/inspo/particle-monogram-burst.png\" alt=\"Particle monogram burst inspiration\" />\n      <div class=\"body\">\n        <div class=\"tag\">Ref D</div>\n        <h3>Particle monogram burst</h3>\n        <p>Dark field + single luminous particle form; restrained, hero-scale.</p>\n      </div>\n    </article>\n  </div>\n\n  <h2>Candidate directions (poker-branded)</h2>\n  <div class=\"dirs\">\n    <article class=\"dir pick\">\n      <div class=\"pill\">Suggested base</div>\n      <h3>Gold ribbon wash</h3>\n      <p>From refs A + C. Midnight field with soft gold / amber / slate ribbons. Best full-page soft layer.</p>\n      <p class=\"prompt\">Dark midnight abstract background, soft flowing ribbon washes in muted gold, warm amber, and cool slate, feathered edges, high negative space, seamless tileable texture, no logos, no cards, no text.</p>\n    </article>\n    <article class=\"dir\">\n      <div class=\"pill\">Alt hero</div>\n      <h3>Gold particle bloom</h3>\n      <p>From refs B + D. Soft gold–champagne particle constellation / bloom on midnight. Hero atmosphere, not a tile.</p>\n      <p class=\"prompt\">Near-black midnight background, dense soft cloud of tiny glowing gold and champagne particles forming a loose circular bloom, faint outward streaks, cinematic, abstract, no text, no logos.</p>\n    </article>\n    <article class=\"dir\">\n      <div class=\"pill\">Optional</div>\n      <h3>Glass hue slabs</h3>\n      <p>From ref A latency cards. Frosted translucent panels in gold / champagne / slate — background only, soft focus.</p>\n      <p class=\"prompt\">Abstract dark background with soft translucent vertical glass slabs in muted gold, champagne, slate, and deep charcoal-green, frosted blur, gentle overlap, no UI text, atmospheric only.</p>\n    </article>\n    <article class=\"dir\">\n      <div class=\"pill\">Mid-page focal</div>\n      <h3>Chip node ring</h3>\n      <p>Ref A integration ring → sparse poker-chip discs with thin gold filaments. Not a full-page tile.</p>\n      <p class=\"prompt\">Dark abstract scene: sparse ring of soft-focus poker chip discs with thin gold edges, connected by delicate gold filaments, shallow depth of field, lots of empty midnight space, no logos, no text.</p>\n    </article>\n  </div>\n\n  <p class=\"footer\">Felt grain was generated earlier and lives at public/landing/felt-texture.png — likely demoted to a micro-overlay if used at all. Shortlist 1–2 directions before spending more Higgsfield credits.</p>\n</div>",
