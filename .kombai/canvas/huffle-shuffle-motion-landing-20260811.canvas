      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Space+Grotesk:wght@500;600;700&display=swap');\n\n  @keyframes gold-breathe {\n    0%, 100% { opacity: .52; transform: scale(.96); }\n    50% { opacity: .88; transform: scale(1.04); }\n  }\n\n  @keyframes cursor-blink {\n    0%, 42% { opacity: 1; }\n    43%, 100% { opacity: 0; }\n  }\n\n  @keyframes signal-pulse {\n    0%, 100% { opacity: .42; transform: scale(.88); }\n    50% { opacity: 1; transform: scale(1); }\n  }\n\n  .huffle-page {\n    --gold: #ffd700;\n    --gold-soft: #f2c14e;\n    --gold-deep: #d4af37;\n    --midnight: #0b0f14;\n    --panel: #111923;\n    --panel-soft: #17202b;\n    --ink: #f8f5ee;\n    --muted: #9ba5b6;\n    font-family: 'DM Sans', sans-serif;\n  }\n\n  .huffle-page h1,\n  .huffle-page h2,\n  .huffle-page h3,\n  .huffle-page .display-font {\n    font-family: 'Space Grotesk', sans-serif;\n  }\n\n  .ambient-gold {\n    animation: gold-breathe 7s ease-in-out infinite;\n  }\n\n  .typing-cursor {\n    animation: cursor-blink .9s steps(1, end) infinite;\n  }\n\n  .live-signal {\n    animation: signal-pulse 1.8s ease-in-out infinite;\n  }\n\n  .story-mask {\n    mask-image: linear-gradient(to bottom, transparent 0%, black 12%, black 88%, transparent 100%);\n    -webkit-mask-image: linear-gradient(to bottom, transparent 0%, black 12%, black 88%, transparent 100%);\n  }\n\n  @media (prefers-reduced-motion: reduce) {\n    .ambient-gold,\n    .typing-cursor,\n    .live-signal {\n      animation: none;\n    }\n  }\n</style>\n<main class=\"huffle-page relative isolate min-h-screen overflow-x-clip bg-[#0b0f14] text-[#f8f5ee] [--gold:#ffd700] [--gold-soft:#f2c14e] [--gold-deep:#d4af37]\" data-kid=\"1\" id=\"top\">\n    <div aria-hidden=\"true\" class=\"pointer-events-none absolute inset-0 -z-20 bg-[radial-gradient(ellipse_at_top_right,rgba(255,215,0,0.13),transparent_42%),radial-gradient(ellipse_at_bottom_left,rgba(212,175,55,0.1),transparent_48%)]\" data-kid=\"1-1\">\n    </div>\n    <div aria-hidden=\"true\" class=\"pointer-events-none absolute inset-0 -z-30 bg-[linear-gradient(180deg,rgba(212,175,55,0.06)_0%,rgba(11,15,20,0)_28%,rgba(0,0,0,0.6)_100%)]\" data-kid=\"1-2\">\n    </div>\n    <img alt=\"\" class=\"pointer-events-none absolute -right-44 top-20 -z-10 h-[560px] w-auto rotate-[-12deg] opacity-25 mix-blend-screen md:h-[700px]\" data-kid=\"1-3\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/public/shuffle1.png\"/>\n    <img alt=\"\" class=\"pointer-events-none absolute -bottom-56 -left-60 -z-10 h-[700px] w-auto rotate-[14deg] opacity-20 mix-blend-screen\" data-kid=\"1-4\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/public/shuffle2.png\"/>\n    <header aria-label=\"Primary navigation\" class=\"relative z-30 mx-auto flex max-w-6xl items-center justify-between px-6 py-6 lg:px-8\" data-kid=\"1-5\">\n        <a aria-label=\"HuffleShuffle home\" class=\"group inline-flex items-center gap-3 text-xs font-semibold tracking-[0.22em] text-white\" data-kid=\"1-5-1\" href=\"#top\">\n            <span aria-hidden=\"true\" class=\"grid size-8 place-items-center rounded-full border border-[#ffd700]/60 bg-[#ffd700]/10 text-sm text-[#ffd700] shadow-[0_0_26px_rgba(255,215,0,0.18)]\" data-kid=\"1-5-1-1\">\n                ♠\n            </span>\n            <span data-kid=\"1-5-1-2\">\n                HUFFLE\n                <span class=\"text-[#ffd700]\" data-kid=\"1-5-1-2-1\">\n                    SHUFFLE\n                </span>\n            </span>\n        </a>\n        <nav aria-label=\"Landing page sections\" class=\"hidden items-center gap-8 text-[11px] font-semibold uppercase tracking-[0.22em] text-[#9ba5b6] md:flex\" data-kid=\"1-5-2\">\n            <a class=\"hover:text-white\" data-kid=\"1-5-2-1\" href=\"#experience\">\n                The room\n            </a>\n            <a class=\"hover:text-white\" data-kid=\"1-5-2-2\" href=\"#how-it-works\">\n                How it works\n            </a>\n            <a class=\"hover:text-white\" data-kid=\"1-5-2-3\" href=\"#final-cta\">\n                Join the waitlist\n            </a>\n        </nav>\n        <div class=\"flex items-center gap-3 text-[10px] font-semibold uppercase tracking-[0.18em] text-[#9ba5b6]\" data-kid=\"1-5-3\">\n            <span aria-hidden=\"true\" class=\"live-signal inline-block size-2 rounded-full bg-[#ffd700] shadow-[0_0_12px_rgba(255,215,0,0.8)]\" data-kid=\"1-5-3-1\">\n            </span>\n            <span class=\"hidden sm:inline\" data-kid=\"1-5-3-2\">\n                Live dealer room\n            </span>\n        </div>\n    </header>\n    <section aria-labelledby=\"hero-title\" class=\"relative mx-auto flex min-h-[760px] max-w-6xl items-center px-6 pb-24 pt-12 lg:px-8\" data-kid=\"1-6\">\n        <div class=\"grid w-full items-center gap-14 lg:grid-cols-[minmax(0,0.86fr)_minmax(0,1.14fr)]\" data-kid=\"1-6-1\">\n            <div class=\"relative z-10 max-w-[610px]\" data-kid=\"1-6-1-1\">\n                <div class=\"hero-kicker mb-6 inline-flex items-center gap-3 rounded-full border border-white/10 bg-white/[0.035] px-4 py-2 text-[10px] font-semibold uppercase tracking-[0.24em] text-[#9ba5b6]\" data-kid=\"1-6-1-1-1\">\n                    <span aria-hidden=\"true\" class=\"size-1.5 rounded-full bg-[#ffd700] shadow-[0_0_10px_rgba(255,215,0,0.8)]\" data-kid=\"1-6-1-1-1-1\">\n                    </span>\n                    Real people. Real tables.\n                </div>\n                <h1 class=\"hero-title max-w-[580px] text-[clamp(3.8rem,7vw,6.8rem)] font-semibold leading-[0.92] tracking-[-0.075em] text-white\" data-kid=\"1-6-1-1-2\" id=\"hero-title\">\n                    Live-Dealer\n                    <span class=\"text-[#ffd700]\" data-kid=\"1-6-1-1-2-1\">\n                        Online Poker\n                    </span>\n                </h1>\n                <p class=\"hero-copy mt-8 max-w-[520px] text-lg leading-8 text-[#b8c0ce]\" data-kid=\"1-6-1-1-3\">\n                    Join a table and play Texas Hold’em streamed live with a live dealer. Simple, fast, and social.\n                </p>\n                <div class=\"hero-actions mt-10 flex max-w-[560px] flex-col gap-3 sm:flex-row sm:items-stretch\" data-kid=\"1-6-1-1-4\">\n                    <form aria-label=\"Join waitlist\" class=\"flex min-h-14 flex-1 items-center gap-2 rounded-xl border border-white/10 bg-white/[0.045] p-2 shadow-[0_18px_50px_rgba(0,0,0,0.2)]\" data-kid=\"1-6-1-1-4-1\">\n                        <label class=\"sr-only\" data-kid=\"1-6-1-1-4-1-1\" for=\"hero-email\">\n                            Email address\n                        </label>\n                        <input class=\"min-w-0 flex-1 bg-transparent px-3 text-sm text-white outline-none placeholder:text-[#6e798a] focus-visible:ring-2 focus-visible:ring-[#ffd700]/70\" data-kid=\"1-6-1-1-4-1-2\" id=\"hero-email\" placeholder=\"you@example.com\" type=\"email\"/>\n                        <button class=\"shrink-0 rounded-lg bg-[#ffd700] px-4 py-3 text-sm font-bold text-[#0b0f14] shadow-[0_0_24px_rgba(255,215,0,0.2)] hover:bg-[#f2c14e] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white focus-visible:ring-offset-2 focus-visible:ring-offset-[#0b0f14]\" data-kid=\"1-6-1-1-4-1-3\" type=\"button\">\n                            Join waitlist\n                        </button>\n                    </form>\n                    <a class=\"inline-flex min-h-14 items-center justify-center rounded-xl border border-white/15 px-5 text-sm font-semibold text-white hover:border-[#ffd700]/60 hover:text-[#ffd700] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#ffd700]\" data-kid=\"1-6-1-1-4-2\" href=\"#how-it-works\">\n                        See how it works\n                        <span aria-hidden=\"true\" class=\"ml-2 text-[#ffd700]\" data-kid=\"1-6-1-1-4-2-1\">\n                            ↓\n                        </span>\n                    </a>\n                </div>\n                <div class=\"hero-note mt-5 flex items-center gap-3 text-[11px] text-[#778295]\" data-kid=\"1-6-1-1-5\">\n                    <span aria-hidden=\"true\" class=\"inline-flex size-5 items-center justify-center rounded-full border border-[#ffd700]/40 text-[10px] text-[#ffd700]\" data-kid=\"1-6-1-1-5-1\">\n                        ✓\n                    </span>\n                    Early access when tables open up. No downloads.\n                </div>\n            </div>\n            <div aria-label=\"Animated gold poker cards\" class=\"hero-visual relative min-h-[520px] lg:min-h-[600px]\" data-kid=\"1-6-1-2\">\n                <div aria-hidden=\"true\" class=\"ambient-gold absolute left-1/2 top-1/2 size-[390px] -translate-x-1/2 -translate-y-1/2 rounded-full bg-[#d4af37]/10 blur-3xl\" data-kid=\"1-6-1-2-1\">\n                </div>\n                <div class=\"hero-card hero-card-heart absolute left-[12%] top-[13%] z-10 w-[190px] rotate-[-14deg] overflow-hidden rounded-[1.35rem] border border-[#ffd700]/35 bg-[#d4af37] shadow-[0_28px_70px_rgba(0,0,0,0.5),0_0_42px_rgba(255,215,0,0.15)] sm:w-[220px]\" data-kid=\"1-6-1-2-2\">\n                    <img alt=\"Gold Ace of Hearts card\" class=\"aspect-[2/3] w-full object-cover\" data-kid=\"1-6-1-2-2-1\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/public/AceHeart.png\"/>\n                </div>\n                <div class=\"hero-card hero-card-spade absolute right-[10%] top-[8%] z-20 w-[205px] rotate-[11deg] overflow-hidden rounded-[1.35rem] border border-[#ffd700]/40 bg-[#d4af37] shadow-[0_30px_80px_rgba(0,0,0,0.6),0_0_42px_rgba(255,215,0,0.2)] sm:w-[238px]\" data-kid=\"1-6-1-2-3\">\n                    <img alt=\"Gold Ace of Spades card\" class=\"aspect-[2/3] w-full object-cover\" data-kid=\"1-6-1-2-3-1\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/public/AceSpade.png\"/>\n                </div>\n                <div aria-hidden=\"true\" class=\"hero-orbit absolute bottom-[13%] left-[18%] h-[180px] w-[240px] rounded-full border border-[#ffd700]/20 [transform:rotate(-20deg)]\" data-kid=\"1-6-1-2-4\">\n                </div>\n                <div aria-hidden=\"true\" class=\"hero-orbit absolute bottom-[8%] left-[26%] h-[130px] w-[180px] rounded-full border border-[#ffd700]/10 [transform:rotate(20deg)]\" data-kid=\"1-6-1-2-5\">\n                </div>\n                <div aria-label=\"Gold dealer chip\" class=\"hero-chip absolute bottom-[21%] right-[22%] z-30 grid size-20 place-items-center rounded-full border-[6px] border-[#1d2430] bg-[#d4af37] shadow-[0_14px_30px_rgba(0,0,0,0.45),inset_0_0_0_2px_rgba(255,215,0,0.78),0_0_30px_rgba(255,215,0,0.28)]\" data-dynamic=\"true\" data-kid=\"1-6-1-2-6\" data-name=\"travelling dealer chip\" data-reason=\"position and rotation animated by scroll position\" id=\"travelling-chip\">\n                    <span class=\"grid size-11 place-items-center rounded-full border border-[#0b0f14]/40 text-[9px] font-bold tracking-[0.12em] text-[#0b0f14]\" data-kid=\"1-6-1-2-6-1\">\n                        DEAL\n                    </span>\n                </div>\n                <div class=\"absolute bottom-0 left-0 rounded-full border border-white/10 bg-[#111923]/80 px-3 py-2 text-[10px] font-semibold uppercase tracking-[0.18em] text-[#778295] backdrop-blur-sm\" data-kid=\"1-6-1-2-7\">\n                    A table is closer than you think\n                    <span aria-hidden=\"true\" class=\"ml-2 text-[#ffd700]\" data-kid=\"1-6-1-2-7-1\">\n                        ↗\n                    </span>\n                </div>\n            </div>\n        </div>\n        <div class=\"absolute bottom-7 left-1/2 hidden -translate-x-1/2 items-center gap-3 text-[10px] font-semibold uppercase tracking-[0.26em] text-[#667184] md:flex\" data-kid=\"1-6-2\">\n            <span aria-hidden=\"true\" class=\"h-px w-12 bg-[#ffd700]/40\" data-kid=\"1-6-2-1\">\n            </span>\n            Scroll to play\n            <span aria-hidden=\"true\" class=\"h-px w-12 bg-[#ffd700]/40\" data-kid=\"1-6-2-2\">\n            </span>\n        </div>\n    </section>\n    <section aria-labelledby=\"experience-title\" class=\"relative mx-auto max-w-6xl px-6 pb-28 lg:px-8\" data-kid=\"1-7\" id=\"experience\">\n        <div class=\"mb-10 flex flex-col justify-between gap-4 border-t border-white/10 pt-8 sm:flex-row sm:items-end\" data-kid=\"1-7-1\">\n            <div data-kid=\"1-7-1-1\">\n                <p class=\"mb-3 text-[10px] font-semibold uppercase tracking-[0.25em] text-[#ffd700]\" data-kid=\"1-7-1-1-1\">\n                    The room\n                </p>\n                <h2 class=\"max-w-xl text-3xl font-semibold tracking-[-0.04em] text-white sm:text-4xl\" data-kid=\"1-7-1-1-2\" id=\"experience-title\">\n                    The casino feeling, without the casino friction.\n                </h2>\n            </div>\n            <p class=\"max-w-sm text-sm leading-6 text-[#778295]\" data-kid=\"1-7-1-2\">\n                Every part of the table is designed to feel immediate, social, and unmistakably live.\n            </p>\n        </div>\n        <div class=\"grid gap-4 md:grid-cols-3\" data-kid=\"1-7-2\">\n            <article class=\"value-card group relative overflow-hidden rounded-2xl border border-white/10 bg-[#111923]/80 p-6 shadow-[0_20px_60px_rgba(0,0,0,0.22)]\" data-kid=\"1-7-2-1\">\n                <div aria-hidden=\"true\" class=\"absolute -right-10 -top-10 size-36 rounded-full bg-[#ffd700]/10 blur-3xl\" data-kid=\"1-7-2-1-1\">\n                </div>\n                <div class=\"relative flex items-center justify-between\" data-kid=\"1-7-2-1-2\">\n                    <span class=\"grid size-10 place-items-center rounded-xl border border-[#ffd700]/25 bg-[#ffd700]/10 text-lg text-[#ffd700]\" data-kid=\"1-7-2-1-2-1\">\n                        ◌\n                    </span>\n                    <span class=\"text-[10px] font-semibold uppercase tracking-[0.2em] text-[#667184]\" data-kid=\"1-7-2-1-2-2\">\n                        01 / 03\n                    </span>\n                </div>\n                <h3 class=\"relative mt-12 text-xl font-semibold text-white\" data-kid=\"1-7-2-1-3\">\n                    Live Dealers\n                </h3>\n                <p class=\"relative mt-3 text-sm leading-6 text-[#9ba5b6]\" data-kid=\"1-7-2-1-4\">\n                    Professionally hosted streams — feel the casino vibe from home.\n                </p>\n                <div aria-hidden=\"true\" class=\"mt-8 h-px w-full bg-gradient-to-r from-[#ffd700]/60 via-[#ffd700]/10 to-transparent\" data-kid=\"1-7-2-1-5\">\n                </div>\n            </article>\n            <article class=\"value-card group relative overflow-hidden rounded-2xl border border-white/10 bg-[#111923]/80 p-6 shadow-[0_20px_60px_rgba(0,0,0,0.22)]\" data-kid=\"1-7-2-2\">\n                <div aria-hidden=\"true\" class=\"absolute -right-10 -top-10 size-36 rounded-full bg-[#ffd700]/10 blur-3xl\" data-kid=\"1-7-2-2-1\">\n                </div>\n                <div class=\"relative flex items-center justify-between\" data-kid=\"1-7-2-2-2\">\n                    <span class=\"grid size-10 place-items-center rounded-xl border border-[#ffd700]/25 bg-[#ffd700]/10 text-lg text-[#ffd700]\" data-kid=\"1-7-2-2-2-1\">\n                        ↗\n                    </span>\n                    <span class=\"text-[10px] font-semibold uppercase tracking-[0.2em] text-[#667184]\" data-kid=\"1-7-2-2-2-2\">\n                        02 / 03\n                    </span>\n                </div>\n                <h3 class=\"relative mt-12 text-xl font-semibold text-white\" data-kid=\"1-7-2-2-3\">\n                    Instant Seats\n                </h3>\n                <p class=\"relative mt-3 text-sm leading-6 text-[#9ba5b6]\" data-kid=\"1-7-2-2-4\">\n                    Jump into active tables with one click. No downloads.\n                </p>\n                <div aria-hidden=\"true\" class=\"mt-8 h-px w-full bg-gradient-to-r from-[#ffd700]/60 via-[#ffd700]/10 to-transparent\" data-kid=\"1-7-2-2-5\">\n                </div>\n            </article>\n            <article class=\"value-card group relative overflow-hidden rounded-2xl border border-white/10 bg-[#111923]/80 p-6 shadow-[0_20px_60px_rgba(0,0,0,0.22)]\" data-kid=\"1-7-2-3\">\n                <div aria-hidden=\"true\" class=\"absolute -right-10 -top-10 size-36 rounded-full bg-[#ffd700]/10 blur-3xl\" data-kid=\"1-7-2-3-1\">\n                </div>\n                <div class=\"relative flex items-center justify-between\" data-kid=\"1-7-2-3-2\">\n                    <span class=\"grid size-10 place-items-center rounded-xl border border-[#ffd700]/25 bg-[#ffd700]/10 text-lg text-[#ffd700]\" data-kid=\"1-7-2-3-2-1\">\n                        ♢\n                    </span>\n                    <span class=\"text-[10px] font-semibold uppercase tracking-[0.2em] text-[#667184]\" data-kid=\"1-7-2-3-2-2\">\n                        03 / 03\n                    </span>\n                </div>\n                <h3 class=\"relative mt-12 text-xl font-semibold text-white\" data-kid=\"1-7-2-3-3\">\n                    Real Decks\n                </h3>\n                <p class=\"relative mt-3 text-sm leading-6 text-[#9ba5b6]\" data-kid=\"1-7-2-3-4\">\n                    Every card is dealt from a real deck by a live dealer on camera — no RNG, no scripts.\n                </p>\n                <div aria-hidden=\"true\" class=\"mt-8 h-px w-full bg-gradient-to-r from-[#ffd700]/60 via-[#ffd700]/10 to-transparent\" data-kid=\"1-7-2-3-5\">\n                </div>\n            </article>\n        </div>\n    </section>\n    <section aria-labelledby=\"how-title\" class=\"relative mx-auto max-w-6xl scroll-mt-8 px-6 pb-36 lg:px-8\" data-kid=\"1-8\" id=\"how-it-works\">\n        <div class=\"mb-16 max-w-2xl\" data-kid=\"1-8-1\">\n            <p class=\"mb-3 text-[10px] font-semibold uppercase tracking-[0.25em] text-[#ffd700]\" data-kid=\"1-8-1-1\">\n                How it works\n            </p>\n            <h2 class=\"text-4xl font-semibold tracking-[-0.055em] text-white sm:text-5xl\" data-kid=\"1-8-1-2\" id=\"how-title\">\n                From first click to first hand.\n            </h2>\n            <p class=\"mt-5 max-w-xl text-base leading-7 text-[#9ba5b6]\" data-kid=\"1-8-1-3\">\n                Four small moves get you from the front door to a live table. Scroll through the room and see what happens next.\n            </p>\n        </div>\n        <div class=\"grid items-start gap-14 lg:grid-cols-[0.72fr_1.28fr] lg:gap-20\" data-kid=\"1-8-2\">\n            <aside aria-label=\"How it works steps\" class=\"sticky top-8 z-20 hidden self-start lg:block\" data-kid=\"1-8-2-1\">\n                <div class=\"rounded-2xl border border-white/10 bg-[#111923]/80 p-6 shadow-[0_25px_80px_rgba(0,0,0,0.25)] backdrop-blur-md\" data-kid=\"1-8-2-1-1\">\n                    <div class=\"mb-7 flex items-center justify-between border-b border-white/10 pb-5\" data-kid=\"1-8-2-1-1-1\">\n                        <span class=\"text-[10px] font-semibold uppercase tracking-[0.22em] text-[#667184]\" data-kid=\"1-8-2-1-1-1-1\">\n                            Your first orbit\n                        </span>\n                        <span class=\"text-[10px] font-semibold tracking-[0.16em] text-[#ffd700]\" data-kid=\"1-8-2-1-1-1-2\">\n                            04 steps\n                        </span>\n                    </div>\n                    <div class=\"relative pl-1\" data-kid=\"1-8-2-1-1-2\">\n                        <div aria-hidden=\"true\" class=\"absolute bottom-5 left-[11px] top-5 w-px bg-gradient-to-b from-[#ffd700]/80 via-white/15 to-white/5\" data-kid=\"1-8-2-1-1-2-1\">\n                        </div>\n                        <nav aria-label=\"Explainer steps\" class=\"relative space-y-5\" data-kid=\"1-8-2-1-1-2-2\">\n                            <a aria-curren