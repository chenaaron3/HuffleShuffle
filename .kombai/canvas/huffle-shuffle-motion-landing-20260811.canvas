nter justify-center rounded-full border border-[#FFD700] bg-[#FFD700] text-[10px] font-bold text-[#11130f]\" data-kid=\"1-9-2-1-2-1-1\" data-name=\"step number icon\">\n                            01\n                        </span>\n                        <span data-kid=\"1-9-2-1-2-1-2\" data-name=\"step label container\">\n                            <span class=\"step-title display-font block text-base font-semibold text-white\" data-kid=\"1-9-2-1-2-1-2-1\" data-name=\"step title\">\n                                Sign in\n                            </span>\n                            <span class=\"mt-1 block text-xs leading-5 text-zinc-500\" data-kid=\"1-9-2-1-2-1-2-2\" data-name=\"step description\">\n                                Create your account and wallet.\n                            </span>\n                        </span>\n                    </button>\n                    <button aria-label=\"Scroll to Enter Lobby step\" class=\"story-nav-item group flex w-full items-start gap-4 rounded-2xl p-3 text-left\" data-kid=\"1-9-2-1-2-2\" data-name=\"step 2 navigation button\" data-scroll-target=\"story-1\" data-step-nav=\"1\" type=\"button\">\n                        <span class=\"step-dot mono-font relative z-10 flex size-9 shrink-0 items-center justify-center rounded-full border border-white/20 bg-[#101821] text-[10px] font-bold text-zinc-500\" data-kid=\"1-9-2-1-2-2-1\" data-name=\"step number icon\">\n                            02\n                        </span>\n                        <span data-kid=\"1-9-2-1-2-2-2\" data-name=\"step label container\">\n                            <span class=\"step-title display-font block text-base font-semibold text-zinc-500\" data-kid=\"1-9-2-1-2-2-2-1\" data-name=\"step title\">\n                                Enter Lobby\n                            </span>\n                            <span class=\"mt-1 block text-xs leading-5 text-zinc-600\" data-kid=\"1-9-2-1-2-2-2-2\" data-name=\"step description\">\n                                Browse live tables and pick your stakes.\n                            </span>\n                        </span>\n                    </button>\n                    <button aria-label=\"Scroll to Buy-in step\" class=\"story-nav-item group flex w-full items-start gap-4 rounded-2xl p-3 text-left\" data-kid=\"1-9-2-1-2-3\" data-name=\"step 3 navigation button\" data-scroll-target=\"story-2\" data-step-nav=\"2\" type=\"button\">\n                        <span class=\"step-dot mono-font relative z-10 flex size-9 shrink-0 items-center justify-center rounded-full border border-white/20 bg-[#101821] text-[10px] font-bold text-zinc-500\" data-kid=\"1-9-2-1-2-3-1\" data-name=\"step number icon\">\n                            03\n                        </span>\n                        <span data-kid=\"1-9-2-1-2-3-2\" data-name=\"step label container\">\n                            <span class=\"step-title display-font block text-base font-semibold text-zinc-500\" data-kid=\"1-9-2-1-2-3-2-1\" data-name=\"step title\">\n                                Buy-in\n                            </span>\n                            <span class=\"mt-1 block text-xs leading-5 text-zinc-600\" data-kid=\"1-9-2-1-2-3-2-2\" data-name=\"step description\">\n                                Join a seat and set your buy-in instantly.\n                            </span>\n                        </span>\n                    </button>\n                    <button aria-label=\"Scroll to Play Live step\" class=\"story-nav-item group flex w-full items-start gap-4 rounded-2xl p-3 text-left\" data-kid=\"1-9-2-1-2-4\" data-name=\"step 4 navigation button\" data-scroll-target=\"story-3\" data-step-nav=\"3\" type=\"button\">\n                        <span class=\"step-dot mono-font relative z-10 flex size-9 shrink-0 items-center justify-center rounded-full border border-white/20 bg-[#101821] text-[10px] font-bold text-zinc-500\" data-kid=\"1-9-2-1-2-4-1\" data-name=\"step num