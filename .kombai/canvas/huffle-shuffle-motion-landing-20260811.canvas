-600\" data-kid=\"1-9-2-2-4-2-2-2-2-2-2\" data-name=\"player status\">\n                                            checked\n                                        </div>\n                                    </div>\n                                    <span class=\"text-xs text-zinc-500\" data-kid=\"1-9-2-2-4-2-2-2-2-3\" data-name=\"player stack\">\n                                        $280\n                                    </span>\n                                </div>\n                                <div class=\"flex items-center gap-3\" data-kid=\"1-9-2-2-4-2-2-2-3\" data-name=\"player 3 row\">\n                                    <span class=\"flex size-8 items-center justify-center rounded-full bg-white/10 text-[10px] text-zinc-400\" data-kid=\"1-9-2-2-4-2-2-2-3-1\" data-name=\"player avatar\">\n                                        M\n                                    </span>\n                                    <div class=\"flex-1\" data-kid=\"1-9-2-2-4-2-2-2-3-2\" data-name=\"player info\">\n                                        <div class=\"text-xs font-semibold\" data-kid=\"1-9-2-2-4-2-2-2-3-2-1\" data-name=\"player name\">\n                                            Mina\n                                        </div>\n                                        <div class=\"mono-font text-[9px] uppercase tracking-[.12em] text-zinc-600\" data-kid=\"1-9-2-2-4-2-2-2-3-2-2\" data-name=\"player status\">\n                                            waiting\n                                        </div>\n                                    </div>\n                                    <span class=\"text-xs text-zinc-500\" data-kid=\"1-9-2-2-4-2-2-2-3-3\" data-name=\"player stack\">\n                                        $365\n                                    </span>\n                                </div>\n                            </div>\n                            <button class=\"mt-9 w-full rounded-xl bg-[#FFD700] py-3 text-xs font-extrabold text-[#11130f] hover:bg-[#f2c14e]\" data-kid=\"1-9-2-2-4-2-2-3\" data-name=\"view table button\" type=\"button\">\n                                View the table ↗\n                            </button>\n                        </div>\n                    </div>\n                </article>\n            </div>\n        </div>\n    </section>\n    <section class=\"relative z-20 mx-auto mb-24 max-w-6xl px-6\" data-kid=\"1-10\" data-name=\"final cta section\" id=\"final-cta\">\n        <div class=\"relative overflow-hidden rounded-[30px] border border-[#FFD700]/20 bg-[radial-gradient(circle_at_86%_8%,rgba(255,215,0,.18),transparent_32%),linear-gradient(135deg,#1c1608,#10150f_62%,#0c1117)] px-7 py-12 shadow-[0_0_80px_rgba(212,175,55,.13)] md:px-12 md:py-14\" data-kid=\"1-10-1\" data-name=\"cta card\">\n            <div class=\"absolute -right-28 -top-28 size-80 rounded-full border border-[#FFD700]/10\" data-kid=\"1-10-1-1\" data-name=\"decorative circle 1\">\n            </div>\n            <div class=\"absolute -right-20 -top-20 size-64 rounded-full border border-[#FFD700]/10\" data-kid=\"1-10-1-2\" data-name=\"decorative circle 2\">\n            </div>\n            <div class=\"absolute right-10 top-9 flex size-16 items-center justify-center rounded-full border border-dashed border-[#FFD700]/55 bg-[#0b0f14]/45 shadow-[inset_0_0_26px_rgba(255,215,0,.08)]\" data-kid=\"1-10-1-3\" data-name=\"chip slot\" id=\"chip-slot\">\n                <span class=\"mono-font text-[8px] uppercase tracking-[.14em] text-[#FFD700]/75\" data-kid=\"1-10-1-3-1\" data-name=\"label\">\n                    dealer\n                    <br data-kid=\"1-10-1-3-1-1\" data-name=\"line break\"/>\n                    button\n                </span>\n            </div>\n            <div class=\"relative max-w-2xl\" data-kid=\"1-10-1-4\" data-name=\"cta content\">\n                <p class=\"mono-font text-[10px] uppercase tracking-[.25em] text-[#FFD700]\" data-kid=\"1-10-1-4-1\" data-name=\"eyebrow label\">\n                    The next hand starts here\n                </p>\n                <h2 class=\"display-font mt-4 text-4xl font-semibold leading-tight text-white md:text-6xl\" data-kid=\"1-10-1-4-2\" data-name=\"section title\">\n                    Ready to take a seat?\n                </h2>\n                <p class=\"mt-5 max-w-xl text-base leading-7 text-zinc-400\" data-kid=\"1-10-1-4-3\" data-name=\"section description\">\n                    Join the waitlist for updates and early access when tables open up.\n                </p>\n                <div class=\"mt-8 flex flex-col gap-4 sm:flex-row sm:items-start\" data-kid=\"1-10-1-4-4\" data-name=\"cta buttons container\">\n                    <form aria-label=\"Join the HuffleShuffle waitlist from final call to action\" class=\"waitlist-form rounded-2xl border border-white/12 bg-black/20 p-2\" data-kid=\"1-10-1-4-4-1\" data-name=\"final waitlist form\">\n                        <div class=\"flex items-center gap-2\" data-kid=\"1-10-1-4-4-1-1\" data-name=\"form group\">\n                            <label class=\"sr-only\" data-kid=\"1-10-1-4-4-1-1-1\" data-name=\"label\" for=\"cta-email\">\n                                Email address\n                            </label>\n                            <input class=\"min-w-0 flex-1 bg-transparent px-3 py-3 text-sm text-white placeholder:text-zinc-500 focus:outline-hidden\" data-kid=\"1-10-1-4-4-1-1-2\" data-name=\"email input\" id=\"cta-email\" placeholder=\"you@email.com\" required=\"\" type=\"email\"/>\n                            <button class=\"waitlist-submit shrink-0 rounded-xl bg-[#FFD700] px-4 py-3 text-xs font-extrabold text-[#11130f] hover:bg-[#f2c14e]\" data-dynamic=\"true\" data-kid=\"1-10-1-4-4-1-1-3\" data-name=\"submit button\" data-reason=\"text and visual state updated on form submission\" type=\"submit\">\n                                Deal me in ↗\n                            </button>\n                        </div>\n                        <p aria-live=\"polite\" class=\"form-status px-3 pb-1 pt-2 text-[10px] text-zinc-500\" data-dynamic=\"true\" data-kid=\"1-10-1-4-4-1-2\" data-name=\"form status message\" data-reason=\"text content updated on form submission\">\n                            Be first at the table.\n                        </p>\n                    </form>\n                    <a class=\"magnetic-button inline-flex min-h-14 items-center justify-center rounded-full border border-white/20 px-6 text-sm font-semibold text-white hover:border-[#FFD700]/60 hover:text-[#FFD700]\" data-kid=\"1-10-1-4-4-2\" data-name=\"back to top button\" href=\"#hero\" id=\"final-cta-button\">\n                        Back to the deal\n                        <span aria-hidden=\"true\" class=\"ml-2 text-[#FFD700]\" data-kid=\"1-10-1-4-4-2-1\" data-name=\"up arrow icon\">\n                            ↑\n                        </span>\n                    </a>\n                </div>\n            </div>\n        </div>\n    </section>\n    <footer class=\"relative z-20 mx-auto flex max-w-6xl flex-col gap-4 border-t border-white/10 px-6 py-8 text-xs text-zinc-600 sm:flex-row sm:items-center sm:justify-between\" data-kid=\"1-11\" data-name=\"footer\">\n        <span class=\"mono-font uppercase tracking-[.16em]\" data-kid=\"1-11-1\" data-name=\"footer logo\">\n            HuffleShuffle · live-dealer poker\n        </span>\n        <span data-kid=\"1-11-2\" data-name=\"footer text\">\n            Real decks. Real dealers. Good hands.\n        </span>\n    </footer>\n</div>\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/gsap.min.js\">\n</script>\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/ScrollTrigger.min.js\">\n</script>\n<script>\n    gsap.registerPlugin(ScrollTrigger);\n  (() => {\n    const init = () => {\n      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;\n      const chip = document.querySelector('#dealer-chip');\n      const canvas = document.querySelector('#motion-canvas');\n      const navItems = Array.from(document.querySelectorAll('.story-nav-item'));\n      const panels = Array.from(document.querySelectorAll('[data-story-panel]'));\n      const revealItems = Array.from(document.querySelectorAll('[data-reveal]'));\n      const setVisible = (selector) => gsap.set(selector, { autoAlpha: 1, x: 0, y: 0, scale: 1, rotation: 0 });\n\n      if (reduceMotion) {\n        setVisible('.hero-copy, .hero-card-left, .hero-card-right, .hero-stats, [data-reveal]');\n        if (chip) gsap.set(chip, { x: 0, y: 0, rotation: 0, autoAlpha: 1 });\n      } else {\n        const intro = gsap.timeline({ defaults: { ease: 'power3.out' } });\n        intro.fromTo('.hero-card-left', { autoAlpha: 0, y: 34, rotation: -22, scale: .92 }, { autoAlpha: 1, y: 0, rotation: -12, scale: 1, duration: .72 })\n          .fromTo('.hero-card-right', { autoAlpha: 0, y: 48, rotation: 18, scale: .88 }, { autoAlpha: 1, y: 0, rotation: 9, scale: 1, duration: .8 }, '-=.48')\n          .fromTo('.hero-eyebrow', { autoAlpha: 0, y: 14 }, { autoAlpha: 1, y: 0, duration: .4 }, '-=.38')\n          .fromTo('.hero-copy h1', { autoAlpha: 0, y: 22 }, { autoAlpha: 1, y: 0, duration: .68 }, '-=.18')\n          .fromTo('.hero-subhead', { autoAlpha: 0, y: 16 }, { autoAlpha: 1, y: 0, duration: .5 }, '-=.34')\n          .fromTo('.hero-actions', { autoAlpha: 0, y: 16, scale: .98 }, { autoAlpha: 1, y: 0, scale: 1, duration: .5 }, '-=.27')\n          .fromTo('.hero-stats', { autoAlpha: 0, y: 12 }, { autoAlpha: 1, y: 0, duration: .42 }, '-=.2');\n\n        gsap.fromTo(revealItems, { autoAlpha: 0, y: 28 }, { autoAlpha: 1, y: 0, duration: .58, stagger: .1, ease: 'power3.out', scrollTrigger: { trigger: '#benefits', start: 'top 76%', once: true } });\n\n        if (chip && canvas) {\n          const chipPath = gsap.timeline({ scrollTrigger: { trigger: canvas, start: 'top top', end: 'bottom bottom', scrub: 1.1, invalidateOnRefresh: true } });\n          chipPath.to(chip, { x: -250, y: 520, rotation: 180, duration: .22, ease: 'none' })\n            .to(chip, { x: -360, y: 1340, rotation: 330, duration: .23, ease: 'none' })\n            .to(chip, { x: -205, y: 2560, rotation: 500, duration: .28, ease: 'none' })\n            .to(chip, { x: 174, y: 3670, rotation: 675, duration: .21, ease: 'none' })\n            .to(chip, { x: 174, y: 3970, rotation: 720, duration: .06, ease: 'none', onStart: () => { chip.style.zIndex = '40'; } });\n          ScrollTrigger.create({ trigger: canvas, start: 'top top', end: 'bottom bottom', scrub: true, onUpdate: (self) => { if (self.progress < .9) chip.style.zIndex = '10'; } });\n        }\n\n        document.querySelectorAll('.tilt-card').forEach((card) => {\n          const onMove = (event) => {\n            const rect = card.getBoundingClientRect();\n            const px = (event.clientX - rect.left) / rect.width - .5;\n            const py = (event.clientY - rect.top) / rect.height - .5;\n            gsap.to(card, { rotationY: px * 9, rotationX: py * -9, transformPerspective: 900, duration: .35, overwrite: 'auto' });\n          };\n          card.addEventListener('pointermove', onMove);\n          card.addEventListener('pointerleave', () => gsap.to(card, { rotationY: 0, rotationX: 0, duration: .6, ease: 'power3.out', overwrite: 'auto' }));\n        });\n      }\n\n      const setActive = (index) => {\n        navItems.forEach((item, itemIndex) => {\n          const active = itemIndex === index;\n          item.classList.toggle('is-active', active);\n          const dot = item.querySelector('.step-dot');\n          const title = item.querySelector('.step-title');\n          if (dot) { dot.classList.toggle('border-[#FFD700]', active); dot.classList.toggle('bg-[#FFD700]', active); dot.classList.toggle('text-[#11130f]', active); dot.classList.toggle('border-white/20', !active); dot.classList.toggle('bg-[#101821]', !active); dot.classList.toggle('text-zinc-500', !active); }\n          if (title) { title.classList.toggle('text-white', active); title.classList.toggle('text-zinc-500', !active); }\n          if (!reduceMotion) gsap.to(item, { autoAlpha: active ? 1 : .45, x: active ? 0 : -4, duration: .24, overwrite: 'auto' });\n          else gsap.set(item, { autoAlpha: active ? 1 : .72, x: 0 });\n        });\n      };\n      setActive(0);\n\n      panels.forEach((panel, index) => {\n        const observer = new IntersectionObserver((entries) => { entries.forEach((entry) => { if (entry.isIntersecting) setActive(index); }); }, { root: null, rootMargin: '-42% 0px -42% 0px', threshold: .04 });\n        observer.observe(panel);\n      });\n      navItems.forEach((item) => item.addEventListener('click', () => { const target = document.getElementById(item.dataset.scrollTarget); if (target) target.scrollIntoView({ behavior: reduceMotion ? 'auto' : 'smooth', block: 'center' }); }));\n\n      document.querySelectorAll('.magnetic-button').forEach((button) => {\n        const onPointerMove = (event) => { const rect = button.getBoundingClientRect(); gsap.to(button, { x: (event.clientX - rect.left - rect.width / 2) * .16, y: (event.clientY - rect.top - rect.height / 2) * .16, duration: .25, overwrite: 'auto' }); };\n        button.addEventListener('pointermove', onPointerMove);\n        button.addEventListener('pointerleave', () => gsap.to(button, { x: 0, y: 0, duration: .45, ease: 'elastic.out(1, .45)', overwrite: 'auto' }));\n      });\n\n      document.querySelectorAll('.waitlist-form').forEach((form) => form.addEventListener('submit', (event) => { event.preventDefault(); const status = form.querySelector('.form-status'); const submit = form.querySelector('.waitlist-submit'); if (status) status.textContent = 'You are on the list — we will deal you in.'; if (submit) { submit.textContent = 'You’re in ✓'; if (!reduceMotion) gsap.fromTo(submit, { scale: .96 }, { scale: 1, duration: .4, ease: 'back.out(2)' }); } }));\n      window.addEventListener('load', () => ScrollTrigger.refresh(), { once: true });\n    };\n    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init, { once: true }); else init();\n  })();\n</script>\n",
      "comments": [],
      "created": "2026-08-11T14:43:15.809972+00:00",
      "modified": "2026-08-11T14:44:50.077260+00:00",
      "id": "var_8b49ab156ba3",
      "viewportScrollY": 1473
    },
    "var_65be82cfdfd5": {
      "type": "variant",
      "label": "Dealer Button Journey",
      "parentId": null,
      "themeId": null,
      "rect": {
        "x": 2760,
        "y": 0,
        "w": 1280,
        "h": 800
      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Space+Grotesk:wght@500;600;700&display=swap');\n  @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@3.34.0/tabler-icons.min.css');\n\n  :root {\n    --midnight: #080b11;\n    --midnight-soft: #0e141d;\n    --charcoal: #151b25;\n    --gold: #f4c95d;\n    --gold-bright: #ffe39a;\n    --muted: #8993a7;\n    --line: rgba(255, 227, 154, 0.16);\n  }\n\n  @keyframes chip-breathe {\n    0%, 100% { box-shadow: 0 0 0 1px rgba(255, 227, 154, 0.2), 0 0 24px rgba(244, 201, 93, 0.18), inset 0 0 12px rgba(255, 255, 255, 0.2); }\n    50% { box-shadow: 0 0 0 1px rgba(255, 227, 154, 0.4), 0 0 42px rgba(244, 201, 93, 0.36), inset 0 0 12px rgba(255, 255, 255, 0.34); }\n  }\n\n  @keyframes live-pulse {\n    0%, 100% { opacity: 0.45; transform: scale(0.86); }\n    50% { opacity: 1; transform: scale(1); }\n  }\n\n  @keyframes chat-rise {\n    0%, 100% { transform: translateY(2px); opacity: 0.72; }\n    50% { transform: translateY(-3px); opacity: 1; }\n  }\n\n  @keyframes ticker-drift {\n    0% { transform: translateY(0); }\n    100% { transform: translateY(-50%); }\n  }\n\n  .route-path {\n    fill: none;\n    stroke-linecap: round;\n    stroke-linejoin: round;\n    vector-effect: non-scaling-stroke;\n  }\n\n  .route-glow { filter: url(#route-blur); }\n\n  .dealer-token {\n    position: absolute;\n    z-index: 6;\n    display: grid;\n    height: 48px;\n    width: 48px;\n    place-items: center;\n    border: 2px solid rgba(255, 239, 183, 0.92);\n    border-radius: 9999px;\n    background: radial-gradient(circle at 32% 26%, #fff4bf 0 8%, #f9d879 22%, #b7791f 67%, #6e4313 100%);\n    color: #3b250b;\n    box-shadow: 0 0 0 5px rgba(245, 201, 93, 0.08), 0 0 30px rgba(245, 201, 93, 0.3), inset 0 0 10px rgba(255, 255, 255, 0.36);\n    transform-style: preserve-3d;\n    will-change: transform;\n    animation: chip-breathe 3.4s ease-in-out infinite;\n  }\n\n  .dealer-token::before {\n    content: '';\n    position: absolute;\n    inset: 5px;\n    border: 1px dashed rgba(70, 40, 9, 0.54);\n    border-radius: inherit;\n  }\n\n  .dealer-token::after {\n    content: 'D';\n    position: relative;\n    z-index: 1;\n    font-family: 'Space Grotesk', sans-serif;\n    font-size: 14px;\n    font-weight: 700;\n    letter-spacing: 0.04em;\n  }\n\n  .dealer-token.static-chip {\n    position: absolute;\n    left: 50%;\n    top: 50%;\n    margin: 0;\n    transform: translate(-50%, -50%);\n    animation: none;\n  }\n\n  .story-rail-item {\n    position: relative;\n    color: #737e93;\n  }\n\n  .story-rail-item.is-active { color: #fff1bd; }\n\n  .story-rail-item.is-active .story-step-index {\n    border-color: var(--gold-bright);\n    background: var(--gold);\n    color: #231707;\n    box-shadow: 0 0 0 5px rgba(244, 201, 93, 0.11), 0 0 20px rgba(244, 201, 93, 0.2);\n  }\n\n  .story-rail-item.is-active .story-step-copy { opacity: 1; }\n  .story-rail-item .story-step-copy { opacity: 0.68; }\n\n  .story-frame {\n    position: relative;\n    isolation: isolate;\n    border: 1px solid rgba(255, 255, 255, 0.11);\n    background: linear-gradient(135deg, rgba(22, 29, 40, 0.96), rgba(10, 14, 21, 0.94));\n    box-shadow: 0 26px 100px rgba(0, 0, 0, 0.22);\n  }\n\n  .story-frame::before {\n    content: '';\n    position: absolute;\n    inset: 0;\n    z-index: -1;\n    border-radius: inherit;\n    background: radial-gradient(circle at 82% 8%, rgba(244, 201, 93, 0.12), transparent 34%);\n    pointer-events: none;\n  }\n\n  .story-frame.is-in-view {\n    border-color: rgba(244, 201, 93, 0.46);\n    box-shadow: 0 32px 120px rgba(0, 0, 0, 0.32), 0 0 56px rgba(244, 201, 93, 0.07);\n  }\n\n  .story-frame:focus-visible {\n    outline: 2px solid var(--gold-bright);\n    outline-offset: 5px;\n  }\n\n  .stack-chip {\n    position: relative;\n    display: grid;\n    height: 48px;\n    width: 48px;\n    place-items: center;\n    border: 3px solid #f4ca67;\n    border-radius: 9999px;\n    background: radial-gradient(circle at 32% 24%, #fff0a6 0 12%, #f6c94e 44%, #b8761c 100%);\n    color: #241705;\n    box-shadow: 0 7px 0 rgba(66, 38, 7, 0.75), inset 0 2px 5px rgba(255, 246, 199, 0.56);\n    font-family: 'Space Grotesk', sans-serif;\n    font-size: 10px;\n    font-weight: 700;\n    transform-origin: center bottom;\n    will-change: transform, opacity;\n  }\n\n  .stack-chip::after { content: attr(data-chip-value); }\n  .stack-chip--silver {\n    border-color: #d9dee9;\n    background: radial-gradient(circle at 32% 24%, #ffffff 0 12%, #dbe0ea 48%, #8994a7 100%);\n    color: #263142;\n    box-shadow: 0 7px 0 rgba(50, 61, 79, 0.75), inset 0 2px 5px rgba(255, 255, 255, 0.65);\n  }\n\n  .ticker-mask {\n    mask-image: linear-gradient(to bottom, transparent, black 17%, black 84%, transparent);\n    -webkit-mask-image: linear-gradient(to bottom, transparent, black 17%, black 84%, transparent);\n  }\n\n  .dealer-cam-image {\n    filter: saturate(0.88) contrast(1.06);\n    transform: scale(1.03);\n  }\n\n  .live-dot { animation: live-pulse 1.8s ease-in-out infinite; }\n  .chat-bubble { animation: chat-rise 2.6s ease-in-out infinite; }\n  .chat-bubble:nth-child(2) { animation-delay: 0.45s; }\n  .chat-bubble:nth-child(3) { animation-delay: 0.9s; }\n  .ticker-track { animation: ticker-drift 12s linear infinite; will-change: transform; }\n  .ticker-track:hover { animation-play-state: paused; }\n\n  .motion-reduced .route-layer { opacity: 0; }\n  .motion-reduced .dealer-token { animation: none; }\n  .motion-reduced .ticker-track,\n  .motion-reduced .live-dot,\n  .motion-reduced .chat-bubble { animation: none; }\n</style>\n<div class=\"relative min-h-screen overflow-x-clip bg-[var(--midnight)] text-white [font-family:'DM_Sans',sans-serif]\" data-kid=\"1\" data-name=\"page layout container\" id=\"page\">\n    <div class=\"pointer-events-none absolute inset-0 z-0 bg-[radial-gradient(circle_at_64%_8%,rgba(244,201,93,0.12),transparent_27%),radial-gradient(circle_at_8%_72%,rgba(58,74,101,0.16),transparent_31%),linear-gradient(180deg,#0d131d_0%,#080b11_38%,#06080c_100%)]\" data-kid=\"1-1\" data-name=\"decorative background gradient\">\n    </div>\n    <div class=\"pointer-events-none absolute inset-0 z-0 opacity-40 [background-image:linear-gradient(rgba(255,255,255,0.025)_1px,transparent_1px),linear-gradient(90deg,rgba(255,255,255,0.025)_1px,transparent_1px)] [background-size:64px_64px] [mask-image:linear-gradient(to_bottom,black,transparent_75%)]\" data-kid=\"1-2\" data-name=\"decorative grid pattern overlay\">\n    </div>\n    <img alt=\"Decorative gold club and chip arc\" class=\"pointer-events-none absolute -right-48 top-8 z-0 h-[620px] w-auto rotate-[10deg] opacity-[0.12] mix-blend-screen\" data-kid=\"1-3\" data-name=\"decorative club and chip graphic\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/public/shuffle1.png\"/>\n    <img alt=\"Decorative gold chip arc\" class=\"pointer-events-none absolute -bottom-96 -left-64 z-0 h-[720px] w-auto opacity-[0.1] mix-blend-screen\" data-kid=\"1-4\" data-name=\"decorative chip arc graphic\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/public/shuffle2.png\"/>\n    <svg aria-hidden=\"true\" class=\"route-layer pointer-events-none absolute inset-x-0 top-0 z-[1] h-full w-full\" data-kid=\"1-5\" data-name=\"dealer route SVG path container\" id=\"route-svg\" preserveaspectratio=\"none\" viewbox=\"0 0 1280 5000\">\n        <defs>\n            <filter height=\"180%\" id=\"route-blur\" width=\"180%\" x=\"-40%\" y=\"-40%\">\n                <fegaussianblur stddeviation=\"7\">\n                </fegaussianblur>\n            </filter>\n        </defs>\n        <path class=\"route-path route-glow\" d=\"M640 470 C760 650 1080 840 962 1190 C866 1475 478 1515 402 1840 C330 2145 826 2360 916 2745 C1004 3125 476 3490 542 3890 C592 4200 824 4435 854 4760\" id=\"dealer-route-glow\" opacity=\"0.22\" stroke=\"#f4c95d\" stroke-width=\"15\">\n        </path>\n        <path class=\"route-path\" d=\"M640 470 C760 650 1080 840 962 1190 C866 1475 478 1515 402 1840 C330 2145 826 2360 916 2745 C1004 3125 476 3490 542 3890 C592 4200 824 4435 854 4760\" id=\"dealer-route\" opacity=\"0.52\" stroke=\"#ffe39a\" stroke-width=\"2\">\n        </path>\n    </svg>\n    <div aria-hidden=\"true\" class=\"dealer-token\" data-dynamic=\"true\" data-kid=\"1-6\" data-name=\"dealer token chip\" data-reason=\"position and rotation updated by scroll-driven GSAP animation\" id=\"dealer-token\" style=\"left: 0; top: 0; transform: translate(616px, 446px)\">\n    </div>\n    <header class=\"relative z-20 mx-auto flex max-w-7xl items-center justify-between px-8 pb-5 pt-7 lg:px-12\" data-kid=\"1-7\" data-name=\"main navigation header\">\n        <div class=\"flex items-center gap-3\" data-kid=\"1-7-1\" data-name=\"brand identity container\">\n            <div aria-hidden=\"true\" class=\"grid h-9 w-9 place-items-center rounded-full border border-[#f4c95d]/60 bg-[#f4c95d]/10 text-[#ffe39a] shadow-[0_0_22px_rgba(244,201,93,0.15)]\" data-kid=\"1-7-1-1\" data-name=\"brand icon container\">\n                <i class=\"ti ti-cards text-[18px]\" data-kid=\"1-7-1-1-1\" data-name=\"cards icon\">\n                </i>\n            </div>\n            <div data-kid=\"1-7-1-2\" data-name=\"brand name and subtitle container\">\n                <div class=\"font-['Space_Grotesk'] text-sm font-semibold tracking-[0.18em] text-[#ffe39a]\" data-kid=\"1-7-1-2-1\" data-name=\"brand name text\">\n                    HUFFLESHUFFLE\n                </div>\n                <div class=\"text-[10px] uppercase tracking-[0.22em] text-slate-500\" data-kid=\"1-7-1-2-2\" data-name=\"brand subtitle text\">\n                    Live-dealer poker\n                </div>\n            </div>\n        </div>\n        <div class=\"hidden items-center gap-7 text-xs uppercase tracking-[0.2em] text-slate-400 md:flex\" data-kid=\"1-7-2\" data-name=\"navigation menu links container\">\n            <span data-kid=\"1-7-2-1\" data-name=\"live tables link text\">\n                Live tables\n            </span>\n            <span class=\"flex items-center gap-2\" data-kid=\"1-7-2-2\" data-name=\"live dealers status indicator\">\n                <span class=\"live-dot h-1.5 w-1.5 rounded-full bg-emerald-300\" data-kid=\"1-7-2-2-1\" data-name=\"live status pulse dot\">\n                </span>\n                Dealers online\n            </span>\n            <a class=\"rounded-full border border-white/10 px-4 py-2 text-slate-300 hover:border-[#f4c95d]/50 hover:text-[#ffe39a] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[#ffe39a]\" data-kid=\"1-7-2-3\" data-name=\"how it works link\" href=\"#journey\">\n                How it works\n            </a>\n        </div>\n    </header>\n    <main class=\"relative z-10\" data-kid=\"1-8\" data-name=\"page content area\">\n        <section class=\"relative mx-auto grid min-h-[850px] max-w-7xl items-center gap-14 px-8 pb-28 pt-14 lg:grid-cols-[1fr_0.92fr] lg:px-12 lg:pt-20\" data-kid=\"1-8-1\" data-name=\"hero section\" id=\"hero\">\n            <div class=\"hero-copy max-w-2xl\" data-kid=\"1-8-1-1\" data-name=\"hero content copy container\">\n                <div class=\"hero-entrance mb-7 flex items-center gap-3 text-xs font-semibold uppercase tracking-[0.3em] text-[#f4c95d]\" data-kid=\"1-8-1-1-1\" data-name=\"hero eyebrow container\">\n                    <span class=\"h-px w-9 bg-[#f4c95d]\" data-kid=\"1-8-1-1-1-1\" data-name=\"hero eyebrow accent line\">\n                    </span>\n                    Live tables, real people\n                </div>\n                <h1 class=\"hero-entrance max-w-2xl font-['Space_Grotesk'] text-6xl font-semibold leading-[0.97] tracking-[-0.06em] text-[#f8e6af] md:text-8xl\" data-kid=\"1-8-1-1-2\" data-name=\"hero headline\">\n                    Live-Dealer\n                    <br data-kid=\"1-8-1-1-2-1\" data-name=\"headline line break\"/>\n                    <span class=\"text-[#f4c95d]\" data-kid=\"1-8-1-1-2-2\" data-name=\"headline highlight text\">\n                        Online Poker\n                    </span>\n                </h1>\n                <p class=\"hero-entrance mt-8 max-w-xl text-lg leading-8 text-slate-300\" data-kid=\"1-8-1-1-3\" data-name=\"hero description text\">\n                    Join a table and play Texas Hold’em streamed live with a live dealer. Simple, fast, and social — from the first shuffle to the final river.\n                </p>\n                <div class=\"hero-entrance mt-10 flex flex-col gap-4 sm:flex-row sm:items-end\" data-kid=\"1-8-1-1-4\" data-name=\"hero action container\">\n                    <form aria-label=\"Join the HuffleShuffle waitlist\" class=\"flex min-w-0 flex-1 flex-col gap-2 sm:max-w-[365px]\" data-kid=\"1-8-1-1-4-1\" data-name=\"join waitlist form\">\n                        <label class=\"sr-only\" data-kid=\"1-8-1-1-4-1-1\" data-name=\"email label\" for=\"hero-email\">\n                            Email address\n                        </label>\n                        <div class=\"flex items-center gap-2 rounded-2xl border border-white/12 bg-white/[0.045] p-1.5 pl-4 shadow-[0_12px_45px_rgba(0,0,0,0.22)] focus-within:border-[#f4c95d]/70 focus-within:ring-2 focus-within:ring-[#f4c95d]/15\" data-kid=\"1-8-1-1-4-1-2\" data-name=\"email input field group\">\n                            <i aria-hidden=\"true\" class=\"ti ti-mail text-[17px] text-slate-500\" data-kid=\"1-8-1-1-4-1-2-1\" data-name=\"email icon\">\n                            </i>\n                            <input autocomplete=\"email\" class=\"min-w-0 flex-1 bg-transparent py-2 text-sm text-white outline-none placeholder:text-slate-600\" data-kid=\"1-8-1-1-4-1-2-2\" data-name=\"email input field\" id=\"hero-email\" placeholder=\"you@example.com\" type=\"email\"/>\n                            <button class=\"rounded-xl bg-[#f4c95d] px-4 py-2.5 text-sm font-semibold text-[#241705] shadow-[0_0_28px_rgba(244,201,93,0.18)] hover:bg-[#ffe39a] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#ffe39a]\" data-kid=\"1-8-1-1-4-1-2-3\" data-name=\"waitlist submit button\" type=\"button\">\n                                Join waitlist\n                            </button>\n                        </div>\n                        <span class=\"pl-2 text-[11px] tracking-wide text-slate-500\" data-kid=\"1-8-1-1-4-1-3\" data-name=\"waitlist privacy note\">\n                            No spam. Just a seat when tables open.\n                        </span>\n                    </form>\n                    <a class=\"group inline-flex items-center gap-3 pb-3 text-sm font-semibold text-[#ffe39a] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[#ffe39a]\" data-kid=\"1-8-1-1-4-2\" data-name=\"already invited link\" href=\"#final-cta\">\n                        Already invited\n                        <span class=\"grid h-8 w-8 place-items-center rounded-full border border-[#f4c95d]/45 bg-[#f4c95d]/10 group-hover:bg-[#f4c95d]/25\" data-kid=\"1-8-1-1-4-2-1\" data-name=\"arrow icon container\">\n                            <i class=\"ti ti-arrow-down-right text-[16px]\" data-kid=\"1-8-1-1-4-2-1-1\" data-name=\"down-right arrow icon\">\n                            </i>\n                        </span>\n                    </a>\n                </div>\n                <div class=\"hero-entrance mt-11 flex flex-wrap gap-x-8 gap-y-3 text-xs uppercase tracking-[0.18em] text-slate-500\" data-kid=\"1-8-1-1-5\" data-name=\"hero footer stats\">\n                    <span data-kid=\"1-8-1-1-5-1\" data-name=\"stat 1\">\n                        <strong class=\"mr-2 text-[#ffe39a]\" data-kid=\"1-8-1-1-5-1-1\" data-name=\"stat 1 value\">\n                            01\n                        </strong>\n                        real decks\n                    </span>\n                    <span data-kid=\"1-8-1-1-5-2\" data-name=\"stat 2\">\n                        <strong class=\"mr-2 text-[#ffe39a]\" data-kid=\"1-8-1-1-5-2-1\" data-name=\"stat 2 value\">\n                            02\n                        </strong>\n                        live dealers\n                    </span>\n                    <span data-kid=\"1-8-1-1-5-3\" data-name=\"stat 3\">\n                        <strong class=\"mr-2 text-[#ffe39a]\" data-kid=\"1-8-1-1-5-3-1\" data-name=\"stat 3 value\">\n                            03\n                        </strong>\n                        instant seats\n                    </span>\n                </div>\n            </div>\n            <div class=\"hero-stage relative mx-auto h-[540px] w-full max-w-[570px] [perspective:1400px]\" data-kid=\"1-8-1-2\" data-name=\"hero card stage container\">\n                <div class=\"hero-card absolute left-[17%] top-[7%] h-[430px] w-[292px] rotate-[-11deg] [transform-style:preserve-3d]\" data-base-rotation=\"-11\" data-kid=\"1-8-1-2-1\" data-name=\"hero card 1 wrapper\" data-tilt-card=\"\">\n                    <img alt=\"Gold Ace of Hearts card\" class=\"h-full w-full object-cover object-center drop-shadow-[0_32px_48px_rgba(244,201,93,0.2)]\" data-kid=\"1-8-1-2-1-1\" data-name=\"hero card 1 image\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/public/AceHeart.png\"/>\n                </div>\n                <div class=\"hero-card absolute right-[11%] top-[18%] z-[2] h-[430px] w-[292px] rotate-[10deg] [transform-style:preserve-3d]\" data-base-rotation=\"10\" data-kid=\"1-8-1-2-2\" data-name=\"hero card 2 wrapper\" data-tilt-card=\"\">\n                    <img alt=\"Gold Ace of Spades card\" class=\"h-full w-full object-cover object-center drop-shadow-[0_32px_54px_rgba(244,201,93,0.24)]\" data-kid=\"1-8-1-2-2-1\" data-name=\"hero card 2 image\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/public/AceSpade.png\"/>\n                </div>\n                <div class=\"absolute bottom-[4%] left-[8%] rounded-full border border-white/10 bg-[#0b1018]/75 px-4 py-2 text-[10px] uppercase tracking-[0.22em] text-slate-500 backdrop-blur-sm\" data-kid=\"1-8-1-2-3\" data-name=\"hero floating info pill\">\n                    The button is moving with you\n                </div>\n                <div class=\"pointer-events-none absolute inset-x-[13%] bottom-[3%] h-28 rounded-full bg-[#f4c95d]/10 blur-3xl\" data-kid=\"1-8-1-2-4\" data-name=\"hero glow element\">\n                </div>\n            </div>\n        </section>\n        <section class=\"relative mx-auto max-w-7xl px-8 pb-40 lg:px-12\" data-kid=\"1-8-2\" data-name=\"value props section\" id=\"value-props\">\n            <div class=\"mb-10 flex items-end justify-between gap-8 border-t border-white/10 pt-7\" data-kid=\"1-8-2-1\" data-name=\"value props header\">\n                <div data-kid=\"1-8-2-1-1\" data-name=\"value props title group\">\n                    <p class=\"mb-3 text-xs uppercase tracking-[0.28em] text-[#f4c95d]\" data-kid=\"1-8-2-1-1-1\" data-name=\"value props eyebrow\">\n                        The table, simplified\n                    </p>\n                    <h2 class=\"font-['Space_Grotesk'] text-3xl tracking-[-0.04em] text-[#f8e6af] md:text-5xl\" data-kid=\"1-8-2-1-1-2\" data-name=\"value props heading\">\n                        Everything you need to sit down.\n                    </h2>\n                </div>\n                <span class=\"hidden max-w-[220px] text-right text-xs leading-5 text-slate-500 md:block\" data-kid=\"1-8-2-1-2\" data-name=\"value props descriptive text\">\n                    A live room without the friction. Follow the gold button as it carries the next step into view.\n                </span>\n            </div>\n            <div class=\"grid gap-4 md:grid-cols-3\" data-kid=\"1-8-2-2\" data-name=\"value props grid\">\n                <article aria-label=\"Live Dealers value proposition\" class=\"value-card group relative min-h-[245px] rounded-[24px] border border-white/10 bg-[#111821]/80 p-7 shadow-[0_20px_70px_rgba(0,0,0,0.18)] hover:border-[#f4c95d]/45 focus-within:border-[#f4c95d]/55\" data-kid=\"1-8-2-2-1\" data-name=\"live dealers value card\" data-reveal=\"\" tabindex=\"0\">\n                    <div class=\"mb-14 flex items-center justify-between\" data-kid=\"1-8-2-2-1-1\" data-name=\"live dealers card header\">\n                        <span class=\"grid h-10 w-10 place-items-center rounded-full border border-[#f4c95d]/35 bg-[#f4c95d]/10 font-['Space_Grotesk'] text-sm text-[#ffe39a]\" data-kid=\"1-8-2-2-1-1-1\" data-name=\"live dealers card index\">\n                            01\n                        </span>\n                        <i aria-hidden=\"true\" class=\"ti ti-video text-[20px] text-[#f4c95d]/70\" data-kid=\"1-8-2-2-1-1-2\" data-name=\"live dealers icon\">\n                        </i>\n                    </div>\n                    <h3 class=\"font-['Space_Grotesk'] text-2xl text-[#f8e6af]\" data-kid=\"1-8-2-2-1-2\" data-name=\"live dealers card title\">\n                        Live Dealers\n                    </h3>\n                    <p class=\"mt-3 max-w-[280px] text-sm leading-6 text-slate-400\" data-kid=\"1-8-2-2-1-3\" data-name=\"live dealers card description\">\n                        Professionally hosted streams — feel the casino vibe from home.\n                    </p>\n                    <div class=\"absolute bottom-7 right-7 h-2 w-2 rounded-full bg-[#f4c95d] shadow-[0_0_18px_rgba(244,201,93,0.7)]\" data-kid=\"1-8-2-2-1-4\" data-name=\"live dealers active indicator\">\n                    </div>\n                </article>\n                <article aria-label=\"Instant Seats value proposition\" class=\"value-card group relative min-h-[245px] rounded-[24px] border border-white/10 bg-[#111821]/80 p-7 shadow-[0_20px_70px_rgba(0,0,0,0.18)] hover:border-[#f4c95d]/45 focus-within:border-[#f4c95d]/55\" data-kid=\"1-8-2-2-2\" data-name=\"instant seats value card\" data-reveal=\"\" tabindex=\"0\">\n                    <div class=\"mb-14 flex items-center justify-between\" data-kid=\"1-8-2-2-2-1\" data-name=\"instant seats card header\">\n                        <span class=\"grid h-10 w-10 place-items-center rounded-full border border-[#f4c95d]/35 bg-[#f4c95d]/10 font-['Space_Grotesk'] text-sm text-[#ffe39a]\" data-kid=\"1-8-2-2-2-1-1\" data-name=\"instant seats card index\">\n                            02\n                        </span>\n                        <i aria-hidden=\"true\" class=\"ti ti-armchair-2 text-[20px] text-[#f4c95d]/70\" data-kid=\"1-8-2-2-2-1-2\" data-name=\"instant seats icon\">\n                        </i>\n                    </div>\n                    <h3 class=\"font-['Space_Grotesk'] text-2xl text-[#f8e6af]\" data-kid=\"1-8-2-2-2-2\" data-name=\"instant seats card title\">\n                        Instant Seats\n                    </h3>\n                    <p class=\"mt-3 max-w-[280px] text-sm leading-6 text-slate-400\" data-kid=\"1-8-2-2-2-3\" data-name=\"instant seats card description\">\n                        Jump into active tables with one click. No downloads.\n                    </p>\n                    <div class=\"absolute bottom-7 right-7 h-2 w-2 rounded-full bg-[#f4c95d] shadow-[0_0_18px_rgba(244,201,93,0.7)]\" data-kid=\"1-8-2-2-2-4\" data-name=\"instant seats active indicator\">\n                    </div>\n                </article>\n                <article aria-label=\"Real Decks value proposition\" class=\"value-card group relative min-h-[245px] rounded-[24px] border border-white/10 bg-[#111821]/80 p-7 shadow-[0_20px_70px_rgba(0,0,0,0.18)] hover:border-[#f4c95d]/45 focus-within:border-[#f4c95d]/55\" data-kid=\"1-8-2-2-3\" data-name=\"real decks value card\" data-reveal=\"\" tabindex=\"0\">\n                    <div class=\"mb-14 flex items-center justify-between\" data-kid=\"1-8-2-2-3-1\" data-name=\"real decks card header\">\n                        <span class=\"grid h-10 w-10 place-items-center rounded-full border border-[#f4c95d]/35 bg-[#f4c95d]/10 font-['Space_Grotesk'] text-sm text-[#ffe39a]\" data-kid=\"1-8-2-2-3-1-1\" data-name=\"real decks card index\">\n                            03\n                        </span>\n                        <i aria-hidden=\"true\" class=\"ti ti-cards text-[20px] text-[#f4c95d]/70\" data-kid=\"1-8-2-2-3-1-2\" data-name=\"real decks icon\">\n                        </i>\n                    </div>\n                    <h3 class=\"font-['Space_Grotesk'] text-2xl text-[#f8e6af]\" data-kid=\"1-8-2-2-3-2\" data-name=\"real decks card title\">\n                        Real Decks\n                    </h3>\n                    <p class=\"mt-3 max-w-[300px] text-sm leading-6 text-slate-400\" data-kid=\"1-8-2-2-3-3\" data-name=\"real decks card description\">\n                        Every card is dealt from a real deck by a live dealer on camera — no RNG, no scripts.\n                    </p>\n                    <div class=\"absolute bottom-7 right-7 h-2 w-2 rounded-full bg-[#f4c95d] shadow-[0_0_18px_rgba(244,201,93,0.7)]\" data-kid=\"1-8-2-2-3-4\" data-name=\"real decks active indicator\">\n                    </div>\n                </article>\n            </div>\n        </section>\n        <section class=\"relative mx-auto max-w-7xl px-8 pb-44 lg:px-12\" data-kid=\"1-8-3\" data-name=\"how it works section\" id=\"journey\">\n            <div class=\"mb-16 max-w-2xl\" data-kid=\"1-8-3-1\" data-name=\"how it works section title\">\n                <p class=\"mb-3 text-xs uppercase tracking-[0.28em] text-[#f4c95d]\" data-kid=\"1-8-3-1-1\" data-name=\"how it works eyebrow\">\n                    How it works\n                </p>\n                <h2 class=\"font-['Space_Grotesk'] text-4xl leading-tight tracking-[-0.05em] text-[#f8e6af] md:text-6xl\" data-kid=\"1-8-3-1-2\" data-name=\"how it works heading\">\n                    From first click\n                    <br data-kid=\"1-8-3-1-2-1\" data-name=\"heading line break\"/>\n                    to\n                    <span class=\"text-[#f4c95d]\" data-kid=\"1-8-3-1-2-2\" data-name=\"heading highlight text\">\n                        play live.\n                    </span>\n                </h2>\n                <p class=\"mt-6 max-w-xl text-base leading-7 text-slate-400\" data-kid=\"1-8-3-1-3\" data-name=\"how it works description\">\n                    Four small moves. One smooth path to the table. The dealer button stays with you while the room comes into focus.\n                </p>\n            </div>\n            <div class=\"grid items-start gap-16 lg:grid-cols-[0.38fr_1fr] lg:gap-24\" data-kid=\"1-8-3-2\" data-name=\"how it works grid\">\n                <aside aria-label=\"How it works steps\" class=\"sticky top-8 self-start\" data-kid=\"1-8-3-2-1\" data-name=\"how it works navigation rail\">\n                    <div class=\"relative pl-8\" data-kid=\"1-8-3-2-1-1\" data-name=\"navigation rail inner\">\n                        <div class=\"absolute bottom-3 left-[36px] top-3 w-px bg-gradient-to-b from-[#f4c95d] via-[#f4c95d]/40 to-white/10\" data-kid=\"1-8-3-2-1-1-1\" data-name=\"navigation progress line\">\n                        </div>\n                        <div class=\"space-y-10\" data-kid=\"1-8-3-2-1-1-2\" data-name=\"navigation steps list\">\n                            <div class=\"story-rail-item is-active\" data-kid=\"1-8-3-2-1-1-2-1\" data-name=\"step 1 nav item\" data-step-nav=\"1\">\n                                <span class=\"story-step-index absolute -left-1 top-0 grid h-4 w-4 place-items-center rounded-full border border-[#f4c95d] bg-[#f4c95d] text-[8px] font-bold text-[#241705]\" data-kid=\"1-8-3-2-1-1-2-1-1\" data-name=\"step 1 index label\">\n                                    1\n                                </span>\n                                <div class=\"story-step-copy\" data-kid=\"1-8-3-2-1-1-2-1-2\" data-name=\"step 1 copy container\">\n                                    <div class=\"font-['Space_Grotesk'] text-lg font-semibold\" data-kid=\"1-8-3-2-1-1-2-1-2-1\" data-name=\"step 1 title\">\n                                        Sign in\n                                    </div>\n                                    <p class=\"mt-2 max-w-[210px] text-xs leading-5\" data-kid=\"1-8-3-2-1-1-2-1-2-2\" data-name=\"step 1 description\">\n                                        Create your account and wallet.\n                                    </p>\n                                </div>\n                            </div>\n                            <div class=\"story-rail-item\" data-kid=\"1-8-3-2-1-1-2-2\" data-name=\"step 2 nav item\" data-step-nav=\"2\">\n                                <span class=\"story-step-index absolute -left-1 top-0 grid h-4 w-4 place-items-center rounded-full border border-white/25 bg-[#101721] text-[8px] font-bold text-slate-400\" data-kid=\"1-8-3-2-1-1-2-2-1\" data-name=\"step 2 index label\">\n                                    2\n                                </span>\n                                <div class=\"story-step-copy\" data-kid=\"1-8-3-2-1-1-2-2-2\" data-name=\"step 2 copy container\">\n                                    <div class=\"font-['Space_Grotesk'] text-lg font-semibold\" data-kid=\"1-8-3-2-1-1-2-2-2-1\" data-name=\"step 2 title\">\n                                        Enter Lobby\n                                    </div>\n                                    <p class=\"mt-2 max-w-[210px] text-xs leading-5\" data-kid=\"1-8-3-2-1-1-2-2-2-2\" data-name=\"step 2 description\">\n                                        Browse live tables and pick your stakes.\n                                    </p>\n                                </div>\n                            </div>\n                            <div class=\"story-rail-item\" data-kid=\"1-8-3-2-1-1-2-3\" data-name=\"step 3 nav item\" data-step-nav=\"3\">\n